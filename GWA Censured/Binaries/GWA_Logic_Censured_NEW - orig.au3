Func Usedp1()
   Local $aBag
   Local $aItem
   Sleep(2)
   For $i = 1 To 4
	  $aBag = GetBag($i)
	  For $j = 1 To DllStructGetData($aBag, "Slots")
		 $aItem = GetItemBySlot($aBag, $j)
		 If DllStructGetData($aItem, "ModelID") == 26784 Then
			UseItem($aItem)
			Return True
		 EndIf
	  Next
   Next
