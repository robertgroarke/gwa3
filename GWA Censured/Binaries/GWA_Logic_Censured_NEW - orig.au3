;~ Checks to see which Guild Hall you are in and the spawn point
Func CheckGuildHall()
	If GetMapID() = $Guild_Hall_Isle_of_Wurms Then
		If CheckArea(8682, 2265) Then MoveTo(8263, 2971)
		If CheckArea(6697, 3631) Then
			MoveTo(7086, 2983)
			MoveTo(8263, 2971)
		EndIf
		If CheckArea(6716, 2929) Then MoveTo(8263, 2971)
		Return True
	EndIf
EndFunc   ;==>CheckGuildHall

