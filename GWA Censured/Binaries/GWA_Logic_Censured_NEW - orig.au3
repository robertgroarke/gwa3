Func LoadBestSkillTemplate()
	Out("Loading optimal skill bar for your profession")
	Switch GetHeroProfession(0)
		Case $Warrior

		Case $Ranger

		Case $Monk

		Case $Necromancer

		Case $Mesmer
			LoadSkillTemplate("OQBDAqwDS5inAuA5AmODBZA2gA", 0)
		Case $Elementalist

		Case $Assassin

		Case $Ritualist
			LoadSkillTemplate("OACjAaiM5S5iXTlT+gQTVTMTDgA", 0)
		Case $Paragon
			LoadSkillTemplate("OQGkURll5iyEPh6WPWNGQoon72ZN", 0)
		Case $Dervish
			LoadSkillTemplate("OgCjkyqDLTjeoXjbjXSXvlIYxXA", 0)
	EndSwitch
	CacheSkillBar()
EndFunc

Func LoadStandardHeroSetup($Build = 1, $PartySize = 8)
	;~ $Build1 = Panic/Ineptitude/E-Surge Wastrel
	;~ $Build2 = PI Wastrel /Ineptitude/Esurge Spiritual Pain
	;~ $Build3 = $Build 2 with rezz on Esurge mesmer
	;~ $Build4 = Customized for Heroic Refrain
	;~ $Build5 = Panic/Ineptitude/E-Surge Wastrel/Well of the Profane
	;~ $Build6 = Preplace esurge with RoJ mesmer
	;~ $Build7 = Preplace MM with RoJ + EoE monk
	;~ $Build8 = Signet Mesmers + RoJ Smite Monk

	KickAllHeroes()

	;~ Master of Whispers (Curses)
	AddHero($HERO_ID_Master)
	Pingsleep(200)
	ChangeSecondProfession($Ritualist, 1)
	Pingsleep(200)
	;ClearAttributes(1)
	If $Build <> 4 And $Build <> 8 Then LoadSkillTemplate("OAhjYgHb4OP1qqdwSUGGmSzJHA", 1)
	If $Build = 4 Then LoadSkillTemplate("OAhjYgHb4SPVVV2BWClB8iDTSTA", 1) ; PoD Healer  for modified bar without healing light - well of ruin instead
	If $Build = 8 Then LoadSkillTemplate("OAhjYgHcoOP1qqdARg0GmSzJHA", 1) ; Shadow of fear and poisoned heart instead of barbs/MoP for non physical teams

	;~ Livia (BiP Healer)
	AddHero($HERO_ID_Livia)
	Pingsleep(200)
	ChangeSecondProfession($Ritualist, 2)
	Pingsleep(200)
	If $Build <> 8 Then LoadSkillTemplate("OAhjQoGYIP3hq6QbcOMncSThHA", 2)
	If $Build = 8 Then LoadSkillTemplate("OAhjQoGYIP3hqq0cyJ8GmU7LGA", 2)	; Replace blood bond wit rezz in non physical team
	Switch $Build
		Case 1 to 6
			AddHero($HERO_ID_Olias)     ; Olias / AotL
			Pingsleep(200)
			ChangeSecondProfession($Paragon, 3)
			Pingsleep(200)
			If $Build <> 4 And $Build <> 5 Then LoadSkillTemplate("OAljUwGopSyBVVUBHVKg7Y1YbhA", 3)
			If $Build = 4 Then LoadSkillTemplate("OAljUsGqpSyBVVUBHVKgoBqY7YA", 3) ; Modified bar with death nova instead of masochism for Heroic Refrain main character
			If $Build = 5 Then LoadSkillTemplate("OAljUwGopSyBVVeBHVKg7Y1YbhA", 3) ; Modified bar with Well of the Profane
		Case 7 to 8
			AddHero($Hero_ID_Dunkoro)		; RoJ
			Pingsleep(200)
			ChangeSecondProfession($Paragon, 3)
			Pingsleep(200)
			LoadSkillTemplate("Owkj4wQjJP+MqvLBva9dr14dMA", 3) ; RoJ + Fall Back
	EndSwitch
	Pingsleep(200)

	;~ Norgu
	AddHero($HERO_ID_Norgu)
	Pingsleep(200)
	ChangeSecondProfession($Ritualist, 4)
	Pingsleep(200)
	;ClearAttributes(4)
	If $Build <> 8 Then LoadSkillTemplate("OQhkAgBsgGK0LAJQeWOgpDCYRwFD", 4)
	If $Build = 8 Then LoadSkillTemplate("OQBDAcMCP/g8spjrh8zBTvhA", 4)

	;~ Gwen
	AddHero($HERO_ID_Gwen)
	Pingsleep(200)
	ChangeSecondProfession($Ritualist, 5)
	Pingsleep(200)
	;ClearAttributes(5)
	Switch $Build
		Case 1, 5, 7
			LoadSkillTemplate("OQhkAkBpAHOENw0TOgpzQQeGC4FD", 5)	; Panic
		Case 2
			LoadSkillTemplate("OQhkAsC8gFKTIc6Z6yB30MwQ4iB", 5) 	; Psychic Instability Wastrels
		Case 3
			LoadSkillTemplate("OQhkAkBpAHOUI00TOgpzQQeGC4FD", 5) ; Psychic Instability Clumsiness
		Case 4
			LoadSkillTemplate("OQlkAoCspdazJY6lDMdDhdsKWeD", 5)	; E-Surge as Me/P for Heroic Refrain main character
		Case 8
			LoadSkillTemplate("OQBDAcMCP/g8spjrh8zBTvhA", 5)
	EndSwitch

	;~ Optional 7th (Razah or Dunkoro)
	If $PartySize = 8 Then
		Switch $Build
			Case 6
				AddHero($Hero_ID_Dunkoro)	; RoJ
				Pingsleep(200)
				ChangeSecondProfession($Paragon, 6)
				Pingsleep(200)
				LoadSkillTemplate("Owkj4wQopO+MqvLBva9dr14dMA+omAdAA", 6)	; RoJ + EoE

			Case Else
				AddHero($HERO_ID_Razah)        ; Razah / e-Surge
				Pingsleep(200)
				ChangeSecondProfession($Ritualist, 6)
				Pingsleep(200)
				If $Build <> 2 And $Build <> 8 Then LoadSkillTemplate("OQhkAsC8gFKzJY6lDMd30hQG4iB", 6)	; E-Surge wastrels
				If $Build = 2 Then LoadSkillTemplate("OQhkAsC8gFKzJY6lDMd40hQG4iB", 6)	; E-Surge spirital pain
				If $Build = 8 Then LoadSkillTemplate("OQhkAsC8gFKTIc6Z6yB30MwQ4iB", 6)	; PI Wastrels
		EndSwitch
	EndIf

	;~ Xandra / ST Ritualist
	If $PartySize > 6 Then
		AddHero($HERO_ID_Xandra)
		Pingsleep(200)
		ChangeSecondProfession($Ritualist, 7)
		Pingsleep(200)
		LoadSkillTemplate("OACjAyhDJPYTrX48xBNRuOzLGA", 7)
	EndIf

EndFunc   ;==>LoadStandardHeroSetup



Func CheckForQuest($quest, $abandoncompleted = False)
	RequestQuestInformation($quest)
	Sleep(200)
	Switch DllStructGetData(GetQuestByID($quest), "LogState")
		Case 0
			Out("Quest is not in our log")
		Case 1
			Out("Quest already in our log, activating")
			SetActiveQuest($quest)
		Case Else
			Out("Quest already completed, abandoning to secure access to the dungeon")
			Out("Logsate = " & DllStructGetData(GetQuestByID($quest), "LogState"))
			If $abandoncompleted Then AbandonQuest($quest)
	EndSwitch
EndFunc   ;==>CheckForQuest

#EndRegion Quest

#Region Loot

Func PickupLootEx($iMaxDist = 2000, $PickupTorch = False)
	$lAgentPtrArray = GetAgentPtrArray(1, 0x400)
	$lPickupDeadlock = TimerInit()
	$lPickupCounter = 0
	For $i = 1 To $lAgentPtrArray[0]
		$lAgentPtr = $lAgentPtrArray[$i]
		$lAgentID = ID($lAgentPtrArray[$i])
		$lItemPtr = GetItemPtrByAgentID($lAgentID) ; GetItemPtrByAgentPtr($lAgentPtr)
		If $lItemPtr = 0 Then ContinueLoop
		$lOwner = MemoryRead($lAgentPtr + 196, 'long')
		If $lOwner <> 0 And $lOwner <> GetMyID() Then ContinueLoop ; assigned to another player
		If CanPickUpEx($lItemPtr, $PickupTorch) And GetDistance($lAgentPtr) < $iMaxDist Then
			MoveTo(X($lAgentPtr), Y($lAgentPtr))
			$lDeadlock = TimerInit()
			Do
				PickUpItem($lAgentID)
				PingSleep(250)
				Out("Pickup")
				$lPickupCounter += 1
			Until GetAgentPtr($lAgentID) <> $lAgentPtr Or GetIsDead(-2)Or TimerDiff($lDeadlock) > 6000 or $lPickupCounter > 10
		EndIf
		If TimerDiff($lPickupDeadlock) > 120000 Or $lPickupCounter > 10 Then Return ; RG try to exit for loop if stuck picking up
	Next
EndFunc   ;==>PickupLootEx

Func CanPickUpEx($aItem, $PickupTorch = False)
	Local $lType = MemoryRead(GetItemPtr($aItem) + 32, "byte")
	Local $lExtraID = MemoryRead(GetItemPtr($aItem) + 34, "short")
	Local $lModelID = MemoryRead(GetItemPtr($aItem) + 44, "long")
	Local $lRarity = GetRarity(GetItemPtr($aItem))
	Local $lQuantity = GetQuantity($aItem), $lValue = GetItemValue($aItem)
	Local $lReq = GetItemReq($aItem), $lDmg = GetItemMaxDmg(GetItemPtr($aItem))

	If CountFreeSlots() < 2 And $lType <> $TYPE_BUNDLE And $lType <> $TYPE_GOLD_COINS Then Return False
	
	If $aRareSkin[$lModelID] <> "" Then
		Out("Picking up " & $aRareSkin[$lModelID])
			$RareSkinsCount += 1
			GUI_SetRareSkins($RareSkinsCount)
		 Return True
	 EndIf
	 
	Switch $lModelID
		Case 2619, 36985 ;Unholy text from Fow, misterial commendations
			Return True
		 Case 27067, 27071, 27033, 27052, 22374 ; Blob Of Ooze, Vaettir Essence, Destroyer Core, Superb Charr Carving Kath Hammer
			Return True
		Case 2605, 2606, 501 to 503, 2566, 2607, 6102, 6104, 6531, 15564, 15565, 15867, 15869 to 15871, 17054, 17055 _
			,17075, 22781, 22782, 25410, 25413, 25416, 24628, 24582 ; General quest items: Prison key (25413), etc.
			Return True
		Case 910, 2513, 5585, 6049, 6366, 6367, 6375, 15477, 19171, 19172, 19173, 22190, 24593, 28435, 30855, 31145, 31146, 35124, 36682 _  ; alcohol
			, 15528, 15479, 19170, 21492, 21812, 22644, 30208, 31150, 35125, 36681 _  ; sweets
			, 17060, 17061, 17062, 22269, 28431, 28432, 28436, 29431, 31151, 31152, 31153, 35121 _  ; Sweet Pcons
			, 6370, 19039, 21488, 21489, 22191, 26784, 28433, 35127 _  ; DP Removal Sweets
			, 556, 18345, 21491, 37765, 21833, 28433, 28434 _ ; Special Drops
			, 935, 936	; Diamond and Onyx
		Return True
	EndSwitch


	Switch $lType
		Case $TYPE_BUNDLE
			If $PickupTorch And ($lModelID = 22342 or $lModelID = 24350) Then ; Unlit Torch, Asura Flame Staff
				Out("Grab unlit torch")
				Return True
			EndIf

		Case $TYPE_DYE
			If $lExtraID = 10 Then ; Black dye
				GUI_SetBlackDyes(GUI_GetBlackDyes() + 1)
				Return True
			EndIf
		Case $TYPE_GOLD_COINS
            If $gPickupCoins And $lModelID = 2511 And GetGoldCharacter() + $lValue < 100000 Then Return True
		Case $TYPE_KEY
			If $lModelID = 22751 Then GUI_SetDroppedLockpicks(GUI_GetDroppedLockpicks() + 1)
			If $lModelID = 22751 Then GUI_SetLockpicks(GetPicksCount())
			If $lModelID = 25410 Or $lModelID = 25416 Then Out("Grab Dungeon Key")
			Return True

		Case $TYPE_MATERIAL_AND_ZCOINS, $TYPE_SCROLL, $TYPE_TROPHY
			Return false
		Case $TYPE_USABLE
			Switch $lModelID
			Case 21786 To 21805 ; RG 21795
					GUI_SetTomes(GUI_GetTomes() + 1)    ; update GUI for tomes only
			Return True
		  EndSwitch
        EndSwitch

Switch $lRarity
;~ Case $RARITY_Blue
;~ Switch $lType
;~ 	  Case $TYPE_SPEAR
;~ 			If $lDmg == 26 And $lReq == 8 Then Return True
;~ 			If $lDmg == 25 And $lReq == 7 Then Return True
;~ 			If $lDmg == 23 And $lReq == 6 Then Return True
;~ 	  Case  $TYPE_SCYTHE
;~ 			If $lDmg == 40 And $lReq == 8 Then Return True
;~ 			If $lDmg == 37 And $lReq == 7 Then Return True
;~ 			If $lDmg == 35 And $lReq == 6 Then Return True
;~ 	  Case $TYPE_SWORD
;~ 			If $lDmg == 22 And $lReq == 8 Then Return True
;~ 			If $lDmg == 20 And $lReq == 7 Then Return True
;~ 			If $lDmg == 19 And $lReq == 6 Then Return True
;~ 	  Case $TYPE_HAMMER
;~ 			If $lDmg == 34 And $lReq == 8 Then Return True
;~ 			If $lDmg == 32 And $lReq == 7 Then Return True
;~ 			If $lDmg == 30 And $lReq == 6 Then Return True
;~ 	  Case $TYPE_BOW
;~ 			If $lDmg == 27 And $lReq == 8 Then Return True
;~ 			If $lDmg == 25 And $lReq == 7 Then Return True
;~ 			If $lDmg == 24 And $lReq == 6 Then Return True
;~ 	  Case $TYPE_AXE
;~ 			If $lDmg == 27 And $lReq == 8 Then Return True
;~ 			if $lDmg == 25 And $lReq == 7 Then Return True
;~ 			If $lDmg == 24 And $lReq == 6 Then Return True
;~ 	  Case $TYPE_DAGGERS
;~ 			If $lDmg == 16 And $lReq == 8 Then Return True
;~ 	  Case $TYPE_SHIELD ; shields
;~ 			If $lReq = 6 And $lDmg = 14   Then Return True
;~ 			If $lReq = 5 And $lDmg = 13   Then Return True
;~ 			If $lReq = 4 And $lDmg = 12   Then Return True
;~ 			EndSwitch
		Case $RARITY_Gold
		If CountFreeSlots() > 8 And GUI_IsPickUpGoldsChecked() Then
			Return  True
		Else
			Return False
		EndIf
	;Case $RARITY_Green
	;	If CountFreeSlots() > 12 Then
	;		Return  True
	;	Else
	;		Return False
	;	EndIf
EndSwitch
	Return False
EndFunc   ;==>CanPickUpEx

Func GetDungeonKey()
	Local $aItem

	Local $lAgentArray = GetAgentArray()
	For $i = 1 To $lAgentArray[0]
		$aAgent = GetAgentByID($i)
		$aItem = GetItemByAgentID($i)
		If Not GetIsMovable($aAgent) Then ContinueLoop
		If DllStructGetData($aItem, 'modelid') = 25410 Or DllStructGetData($aItem, 'modelid') = 25416 Then Return $lAgentArray[$i] ; SoO: 25410, Bogroot: 25416
	Next
	Return False
EndFunc   ;==>GetDungeonKey

Func GetTorch()
	Local $aItem
	For $i = 1 To GetMaxAgents()
		$aAgent = GetAgentByID($i)
		If Not GetIsMovable($aAgent) Then ContinueLoop
		$aItem = GetItemByAgentID($i)
		If DllStructGetData($aItem, 'modelid') = 22342 Then ExitLoop
	Next

	If $i = GetMaxAgents() + 1 Then Return 0
	Return $i
EndFunc   ;==>GetTorch

Func GetTargetItemModelID()
	$lItemPtr = GetItemPtrByAgentID(GetCurrentTargetID())
	$lModelID = MemoryRead($lItemPtr + 44, "long")
	Return $lModelID
EndFunc   ;==>GetTargetItemModelID

Func GetTargetExtratype()
	$lItemPtr = GetItemPtrByAgentID(GetCurrentTargetID())
	$lExtraID = MemoryRead(GetItemPtr($aItem) + 34, "short")
	Out($lExtraID)
	Return $lExtraID
EndFunc   ;==>GetTargetExtratype

Func TakePowder($X, $Y)
	GoToNPCNearXY($X, $Y, 6179)
	PingSleep(500)
	MoveTo($X, $Y)
	DropBundle()
	AggroMoveToEx($X, $Y)
EndFunc
