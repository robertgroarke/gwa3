Func CheckArea($aX, $aY)
	$ret = False
	$pX = DllStructGetData(GetAgentByID(-2), "X")
	$pY = DllStructGetData(GetAgentByID(-2), "Y")

	If ($pX < $aX + 500) And ($pX > $aX - 500) And ($pY < $aY + 500) And ($pY > $aY - 500) Then
		$ret = True
	EndIf
	Return $ret
EndFunc   ;==>CheckArea


Func MoveandAggro($aWaypoints)
	Local $lMapId = GetMapId()
	For $i = GetNearestWaypointIndex($aWaypoints) To UBound($aWaypoints) - 1 Step 1
		BossGlow(ID(GetAgentByID(-2)), Random(2, 10, 1))
		$NearestWaypoint = GetNearestWaypointIndex($aWaypoints)
		Sleep(200)
		If GetMapId() <> $lMapId Then Return ; Need to get out of this MoveAggro loop if the mapid changes
		; (SoO only) unlit effect intercept - backtracks until lit effect is reapplied and resumes at light torch waypoint
		; Consets arent working - duration check is wrong or something
		;If(GUI_IsConsetsChecked() and (GetMapId() = $Bogroot_Growths_Lvl1 Or GetMapId() = $Bogroot_Growths_Lvl2)) Then UseConsets()
		;If(GUI_IsConsetsChecked() and (GetMapId() = $Bogroot_Growths_Lvl1 Or GetMapId() = $Bogroot_Growths_Lvl2)) Then UseArmor()
		If $unlit Then $i = RekindleTorch($aWaypoints, $NearestWaypoint)
        If GetMapLoading() == 2 Then Disconnected()
		If Wipe() = 1 Then    ; wipe intercept - wait until rezz and redirect to best waypoint, check for GetIsDead first to avoid checking fo wipe all the time..
			GUI_SetWipes(GUI_GetWipes() + 1)
			$LastWaypoint = $i
			Out("We wiped at " & $aWaypoints[$LastWaypoint][3] & ", waiting for rezz")
			CancelAll()    ; in case we were pulling enemie
			$lDeadlock = TimerInit()
			$lWipeWaitCounter = 0
			Do
				Sleep(500)
				$lWipeWaitCounter += 1
				If GetPartyDefeated() Or TimerDiff($lDeadlock) > 120000 or $lWipeWaitCounter > 240 Then Return ResignAndReturn($Outpost, $Language)
				Until GetPartyHealth() > 0.5
				if GetMorale() < -40 then Usedp()
			$NearestWaypoint = GetNearestWaypointIndex($aWaypoints)
			$i = WipeManagement($aWaypoints, $NearestWaypoint, $LastWaypoint)    ; converts nearest waypoint to the desired waypoint based on last or nearest waypoint
			Out("Restarting at : " & $aWaypoints[$i][3])
		EndIf

		Out("Nearest waypoint - " & $aWaypoints[$NearestWaypoint][3])
		Out("Moving to - " & $aWaypoints[$i][3])

		Switch ($aWaypoints[$i][3])
		   	Case "Boss lock", "Chest", "Signpost"
				If Wipe() = 0 Then GoToSignpostNearXY($aWaypoints[$i][0], $aWaypoints[$i][1])
				PickupLootEx()
			Case Else
				If GetMapLoading() = 1 Then AggroMoveToEX($aWaypoints[$i][0], $aWaypoints[$i][1], $aWaypoints[$i][2])
				If GetMapLoading() = 0 Then MoveTo($aWaypoints[$i][0], $aWaypoints[$i][1])
		EndSwitch
	Next
EndFunc   ;==>MoveandAggro

;~Run and aggro management for chest running
Func MoveChestrunning($aWaypoints)
	$Me = GetAgentByID()

	For $i = GetNearestWaypointIndex($aWaypoints) To UBound($aWaypoints) - 1 Step 1
		$NearestWaypoint = GetNearestWaypointIndex($aWaypoints)
		Sleep(100)
		If GetMapLoading() == 2 Then Disconnected()

		If GetisDead(-2) and $aWaypoints[$i][3] <> "Please Go Die" and $aWaypoints[$i][3] <> "Wait for Rez" Then
			Return ResignAndReturn($Outpost, $Language)
		EndIf

		Out("Nearest waypoint - " & $aWaypoints[$NearestWaypoint][3])
		Out("Moving to - " & $aWaypoints[$i][3])

		Switch ($aWaypoints[$i][3])
			Case "Function Call"            ; Calls the function defined in the third column of the Waypoint array
				If GetIsDead(-2) Then Return
				Call($aWaypoints[$i][2])

			Case "Function Call with Coordinates"    ; Calls the function defined in the third column of the Waypoint array with coordinate parameters
				If GetIsDead(-2) Then Return
				Call($aWaypoints[$i][2], $aWaypoints[$i][0], $aWaypoints[$i][1])

			Case "Find The Damn Chest"
				If GetIsDead(-2) Then Return
				CheckForChest(True)

			Case "Please Go Die" ; Move to your death
				MoveTo($aWaypoints[$i][0], $aWaypoints[$i][1])
				Do
					Sleep(250)
				Until GetIsDead(-2)

			Case "Wait for Rez"    ; Wait to get ressurected
				Do
					Sleep(250)
				Until Not GetIsDead(-2)

			Case "Normal Movement"
				If GetIsDead(-2) Then Return
				MoveTo($aWaypoints[$i][0], $aWaypoints[$i][1])

			Case "Flag Heroes"
				If GetIsDead(-2) Then Return
				CommandAll($aWaypoints[$i][0], $aWaypoints[$i][1])

			Case "Flag Hero"
				If GetIsDead(-2) Then Return
				CommandHero($aWaypoints[$i][2], $aWaypoints[$i][0], $aWaypoints[$i][1])

			Case "Unflag Heroes"
				If GetIsDead(-2) Then Return
				CancelAll()

			Case "Backtracking"                                ; use to backtrack without replicating existing waypoints
				If GetIsDead(-2) Then Return
				For $j = $aWaypoints[$i][0] To $aWaypoints[$i][1] Step -1
					Out("Backtracking - " & $aWaypoints[$j][3])
					MoveAndSurvive($aWaypoints[$j][0], $aWaypoints[$j][1], $aWaypoints[$j][2])
				Next

			Case "Take Quest"
				If GetIsDead(-2) Then Return
				TakeQuest($aWaypoints[$i][0], $aWaypoints[$i][1], $aWaypoints[$i][2], $questNPC)

			Case "Take NPC Quest"
				If GetIsDead(-2) Then Return
				TakeQuest(X(), Y(), $aWaypoints[$i][1], $aWaypoints[$i][0])

			Case "Select quest"
				If GetIsDead(-2) Then Return
				Dialog($aWaypoints[$i][2])

			Case "Skip Cinematic"
				If GetIsDead(-2) Then Return
				Move($aWaypoints[$i][0], $aWaypoints[$i][1])
				SkipCinematic()
				MoveAndSurvive($aWaypoints[$i][0], $aWaypoints[$i][1], $aWaypoints[$i][2])

			Case "Map Travel"
				Out("Traveling to " & $MAP_ID[$aWaypoints[$i][2]])
				TravelTo($aWaypoints[$i][2], $Language)
				Return True

			Case "Portal"                        ; Each waypoint array should end with a "portal" waypoint with the mapID as a parameter
				Do
					Move($aWaypoints[$i][0], $aWaypoints[$i][1], 0)
				Until WaitMapLoading($aWaypoints[$i][2])

			Case "Aggro"
				AggroMoveToEX($aWaypoints[$i][0], $aWaypoints[$i][1], $aWaypoints[$i][2])

			Case Else
				If GetIsDead(-2) Then Return
				MoveAndSurvive($aWaypoints[$i][0], $aWaypoints[$i][1], $aWaypoints[$i][2])
		EndSwitch
	Next
EndFunc   ;==>MoveChestrunning

Func WipeManagement($aWaypoints, $NearestWaypoint, $LastWaypoint)                     ; after a wipe, converts nearest waypoint to the desired waypoint based on last waypoint
	Out("Last waypoint - " & $aWaypoints[$LastWaypoint][3])

	Switch GetMapID()
		Case $Shards_of_Oor_Lvl1
			Switch $aWaypoints[$NearestWaypoint][3]
			Case 1 to 9
			     Return 1
			Case 10 to 14
			     Return 10
			Case 15 to 20													       ; on level 1, when wiping before portal need to restart from before boss lock
			    Return 14
			EndSwitch

		Case $Shards_of_Oor_Lvl2
			Switch $aWaypoints[$NearestWaypoint][3]
			   Case  1 to 3												       ; on level 1, when wiping before portal need to restart from before boss lock
					Return 1
			   Case  4 to 11											       ; on level 1, when wiping before portal need to restart from before boss lock
					Return 4
			EndSwitch

	    Case $Shards_of_Oor_Lvl3
			Switch $aWaypoints[$NearestWaypoint][3]
                Case 1 to 8
			      Return 1
			   Case 9 to 16
			      Return 9
			   Case 17 to 20
			      Return 20
			   Case 21 To 41
			     Return 23
		    	EndSwitch
			 Case $iSplarkflyMapID
		 Switch $aWaypoints[$NearestWaypoint][3]
			   Case 1 to 6
			    Return 4
			   Case 7 to 17
			    Return 7
		     	EndSwitch

		Case $Bogroot_Growths_Lvl1
			Switch $aWaypoints[$NearestWaypoint][3]
				Case 14
					Return 9
			EndSwitch

		Case $Bogroot_Growths_Lvl2
			Switch $aWaypoints[$NearestWaypoint][3]
				Case 1 to 8
					Return 1
			EndSwitch

	EndSwitch
	Return $NearestWaypoint
EndFunc   ;==>WipeManagement

Func TakeQuest($x, $y, $aQuestID, $aPlayerID = 0)
	Out("Taking Quest")
	AggroMoveToEX($x, $y, 1350)
	GoToNPCNearXY($x, $y, $aPlayerID)
	Out("Quest Status: " & QuestLogState($aQuestID))
	GetReward($x, $y, $aQuestID, $aPlayerID)        ; function returns if the quest is not active
	Pingsleep(500)
	AcceptQuest($aQuestID)
	If $dialog <> 0 Then
		GoNPC()
		Pingsleep(200)
		Dialog($dialog)
	EndIf
	#CS
	Switch $QuestStatus
		Case 0
			Out("Quest is not in our log, accepting quest")
			AcceptQuest($quest)
			If $dialog <> 0 Then
				GoNPC()
				Pingsleep(200)
				Dialog($dialog)
			EndIf
		Case 3, 34, 35, 79
			Out("Logsate = " & DllStructGetData(GetQuestByID($quest), "LogState"))
			Out("Quest already completed, accepting reward")
			GetReward($x, $y, $quest, $aPlayerID)
		Case Else
			Out("Quest already in our log, reactivating")
			AcceptQuest($quest)    ; we reactivate the quest (needed for dungeons)
			If $dialog <> 0 Then
				GoNPC()
				Pingsleep(200)
				Dialog($dialog)
			EndIf
	EndSwitch
	#CE
EndFunc   ;==>TakeQuest

Func TalkToNPC($x, $y, $talk, $dialog = 0, $aPlayerID = 0)
	Out("Talk to NPC " & $aPlayerID)
	GoToNPCNearXY($x, $y, $aPlayerID)
	PingSleep(500)
	Dialog($talk)
	If $dialog <> 0 Then
		Dialog($dialog)
	EndIf
	$Timer = TimerInit()
	Do
		SendPacket(0x4, $HEADER_SKIP_CINEMATIC)
		Sleep(200)
		$lTypeMap = MemoryRead(GetAgentPtr(-2) + 344, 'long')
	Until BitAND($lTypeMap, 4194304) or TimerDiff($Timer) > 5000
EndFunc   ;==>TalkToNPC


Func EnterMission($x, $y, $mission, $dialog, $aPlayerID = 0)
	GoToNPCNearXY($x, $y, $aPlayerID)
	Dialog($mission)
	Dialog($dialog)
	Waitmaploading(0, 10000, True)
EndFunc   ;==>EnterMission

Func GoToSignpostEX($x, $y) ; Open dungeon lock, torch chest
	Local $lDeadlock
	$lDeadlock = TimerInit()

	Sleep(50)
	If Wipe() = 1 Then Return
	If Wipe() = 0 Then MoveTo($x, $y)

	Do
		RndSleep(250)
		Local $lNearestAgent, $lNearestDistance = 100000000
		Local $lDistance
		Local $lAgentArray = GetAgentArray(0x200)

		For $i = 1 To $lAgentArray[0]
			$lDistance = ($x - X($lAgentArray[$i])) ^ 2 + ($y - Y($lAgentArray[$i])) ^ 2

			If DllStructGetData($lAgentArray[$i], 'type') = 512 And $lDistance < $lNearestDistance Then            ; prevents Shandra from being confused with signpost
				$lNearestAgent = $lAgentArray[$i]
				$lNearestDistance = $lDistance
			EndIf
		Next
	Until DllStructGetData($lNearestAgent, 'Id') <> 0 Or Wipe() = 1 Or TimerDiff($lDeadlock) > 30000
	If Wipe() = 0 Then ChangeTarget($lNearestAgent)
	RndSleep(250)
	;	GoToSignpost($lock)
	Do
		RndSleep(500)
		ActionInteract()
	Until GetDistance($lNearestAgent, -2) < 150 Or Wipe() = 1
	Sleep(500)
EndFunc   ;==>GoToSignpostEX

Func ChestAndReward($aWaypoints, $x, $y, $reloadmap = 0, $aPlayerID = 0)

	Endchest($x, $y)                            	    ;~ Find and open end chest
	If $GUI_RunCounter > 0 Then
		GUI_SetAvgRunTime(AvgRunTime())
		GUI_SetBestRunTime(BestRunTime())
	EndIf
	AdlibUnRegister("CurrentRunTime")

	FindRewardNPCByPlayerID($aWaypoints, $aPlayerID)    ;~Backtrack as far as necessary to find Reward NPC
	GetReward($x, $y, $quest, $aPlayerID)               ;~Accept reward

	;If $GUI_GroupSettings_CheckSalvage = True And CountFreeSlots($UseBags) < 8 Then Return SalvageItems()
	If $reloadmap <> 0 Then WaitMapLoading($reloadmap, 300000)

EndFunc   ;==>ChestAndReward

Func Endchest($x, $y, $reloadmap = 0)
   Out("Boss Group Dead")
   Out("Opening Chest")
   AggroMoveToEX($x, $y, $spellcasting_range)

   GoToSignPost(GetEndChest())
   PingSleep(1500)
   Out("Pick Up Drops")
   PickupLootEx(5000)

   If GetIsDead(-2) Then Return
   If $reloadmap <> 0 Then WaitMapLoading($reloadmap, 300000)

EndFunc   ;==>Endchest

Func GetEndChest()
	Local $lAgentPtrArray = GetAgentPtrArray(1, 0x200)
	For $i = 1 To $lAgentPtrArray[0]
		$lExtraType = MemoryRead($lAgentPtrArray[$i] + 208, 'long')
		Switch $lExtraType
			Case 8926 to 8934 	; EotN dungeon chests, may need to expand range for some dungeons
				Out("End chest found")
				Return $lAgentPtrArray[$i]	; DllStructGetData($lAgentArray[$i],'ID')
		EndSwitch
	Next
	Return 0
EndFunc   ;==>GetEndChest

;~ Backtracks a waypoint array to find stuck reward NPCs; Contains a special case for Shards of Orr where some backtracking waypoints need to be skipped
Func FindRewardNPCByPlayerID($aWaypoints, $aPlayerID)
	Out("Find Reward NPC")
	$timer = TimerInit()
	Switch GetMapID()
		Case $Shards_of_Oor_Lvl3
			For $i = UBound($aWaypoints) - 2 To 1 Step -1
				Out($aPlayerID)
				$shandra = DllStructGetData(GetAgentByPlayerNumber($aPlayerID), "ID")
				If $aWaypoints[$i][3] <> "Fendi's lair" And GetDistance(GetAgentByPlayerNumber($aPlayerID), -2) < 3000 Or Wipe() = 1 Then Return    ; may still wipe on poison traps
				Out("Where the f*ck is Shandra?! Searching at - " & $aWaypoints[$i][3])
				AggroMoveToEX($aWaypoints[$i][0], $aWaypoints[$i][1], $spellcasting_range)
				If $i = UBound($aWaypoints) - 7 Then $i = 25    ; skipping waypoints to get from boss lock straight to room 2
				If TimerDiff($timer) > 160000 Then Return False	; time out to ensure we return from current level before beign wraped back to dungeon entrance
			Next
		Case Else
			For $i = UBound($aWaypoints) - 2 To 1 Step -1
				AggroMoveToEX($aWaypoints[$i][0], $aWaypoints[$i][1], $spellcasting_range)
				; Out("Distance to quest NPC: " & Floor(GetDistance(GetAgentByPlayerNumber($aPlayerID)), -2)))
				If GetDistance(GetAgentByPlayerNumber($aPlayerID), -2) < 3000 Or Wipe() = 1 Then Return
				If TimerDiff($timer) > 160000 Then Return False ; time out to ensure we return from current level before beign wraped back to dungeon entrance
			Next
	EndSwitch
EndFunc   ;==>FindRewardNPCByPlayerID

; Accepts quest reward from an NPC for a given Quest ID
Func GetReward($x, $y, $aQuest, $aPlayerID = 0)
	GoToNPCNearXY($x, $y, $aPlayerID)
	QuestReward($aQuest)
EndFunc   ;==>GetReward

Func ForceOpenChest($x, $y)
	Local $ChestFound = False
	$lDeadlock = TimerInit()
	If Wipe() = 1 Then Return
	Do
		RndSleep(250)
		$Chest = GetNearestSignpostToCoords($x, $y)
	Until DllStructGetData($Chest, 'Id') <> 0 Or TimerDiff($lDeadlock) > 300000

	$AgentArray = GetAgentArraySorted(0x200)    ;0x200 = type: static
	For $i = 0 To UBound($AgentArray) - 1    ;there might be multiple chests in range
		$lAgent = GetAgentByID($AgentArray[$i][0])
		$lExtraType = DllStructGetData($lAgent, 'ExtraType')
		If $lExtraType <> 4582 And $lExtraType <> 8141 And $lExtraType <> 8926 And $lExtraType <> 8934 And $lExtraType <> 8932 And $lExtraType <> 70 And $lExtraType <> 6 And $lExtraType <> 2 Then ContinueLoop
		; Zaischenchest 9523; Sorrow's Furance Chest: 2; Bogroot: 8932 ; SoO: 8934; Miner's Chest: 70
	Next
	Out("opening chest")

	AggroMoveToEX(X($Chest), Y($Chest))

	ChangeTarget($Chest)
	Sleep(250)
	Do
		Sleep(200)
		ActionInteract()
	Until GetDistance($Chest, -2) < 150
	OpenChest()
	Sleep(500)
EndFunc   ;==>ForceOpenChest

; returns the index of the nearest waypoint in an array of waypoints
Func GetNearestWaypointIndex($aWaypoints)
	Local $lNearestWaypoint, $lNearestDistance = 100000000
	Local $lDistance
	For $Index = 0 To UBound($aWaypoints) - 1
		$lDistance = GetDistanceToXY($aWaypoints[$Index][0], $aWaypoints[$Index][1])
		If $lDistance < $lNearestDistance Then
			$lNearestWaypoint = $Index
			$lNearestDistance = $lDistance
		EndIf
	Next
	Return $lNearestWaypoint
EndFunc   ;==>GetNearestWaypointIndex


;~ Run and aggro management
Func AggroMoveToEX($x, $y, $aFightRange = 1350)
	Local $lDeadlock, $lBlocked, $aOldX, $aOldY
	Local $random = 100
	If GetMapLoading() <> 1 Or GetMapLoading() = 2 Then Return True
	If WeCanMove($aFightRange) Then Move($x, $y, $random)
	$TimerAggro = TimerInit()
	Do
		$aOldX = X(-2)
		$aOldY = Y(-2)
		If GetMapLoading() == 2 Then Disconnected()
		If GetNearestDistance() < $aFightRange Then Fight($aFightRange)
		If GUI_IsChestChecked() Then CheckForChest()
		If WeCanMove($aFightRange) Or TimerDiff($TimerAggro) > 60000 Then
			Move($x, $y, $random)
			PickupLootEx(3000)
			If X(-2) = $aOldX And Y(-2) = $aOldY Then
				$lBlocked += 1
				Move(X(-2), Y(-2), 500)
				PingSleep(350)
				Move($x, $y, $random)
			EndIf
		EndIf
	Until GetDistanceToXY($x, $y) < 250 Or $lBlocked > 30 Or TimerDiff($TimerAggro) > 240000 Or Wipe() Or ConditionalSkipCinematic()

EndFunc   ;==>AggroMoveToEX



Func WeCanMove($aRange = $longbow_Range)
	Local $heroXY[2]
	If GetNearestDistance() < $aRange And $aRange < $longbow_Range Then Return False
	$OldPartyHP = GetPartyHealth()
	Return True
EndFunc   ;==>WeCanMove

Func MoveAndSurvive($lDestX, $lDestY, $lRandom = 100, $safe_distance = 1750)
	Local $lDeadlock
	Local $lBlocked, $OldPartyHP
	Local $lHosCount
	Local $lAngle
	Local $stuckTimer = TimerInit()
	If GetIsDead(-2) Then Return False
	If GetMapLoading() <> 1 Then Return True
	If GetMapLoading() = 2 Then Return False ; loading screen
	$lDeadlock = TimerInit()
	Move($lDestX, $lDestY, $lRandom)
	Do
		RndSleep(100)
		If GetIsDead(-2) Then ExitLoop
		SpeedBoost()
		Move($lDestX, $lDestY, $lRandom)
		If GetNearestDistance() < $safe_distance Then Survive($safe_distance)

		If not GetIsMoving() Then
			If GetIsDead(-2) Then ExitLoop
			If GetNearestDistance() < $safe_distance Then Survive($safe_distance)
			If $lHosCount > 6 Then
				Do    ; suicide
					Sleep(100)
				Until GetIsDead(-2)
				Return False
			EndIf
			$lBlocked += 1
			If $lBlocked < 5 Then
				Move($lDestX, $lDestY, $lRandom)
			ElseIf $lBlocked < 10 Then
				$lAngle += 40
				Move(X(-2) + 300 * Sin($lAngle), Y(-2) + 300 * Cos($lAngle))
			ElseIf $lBlocked > 9 Then
				If $lHosCount == 0 And GetNearestDistance() < 1000 Then
					UseSkillEX($SkillbarSlot[$Heart_of_Shadow], GetNearestEnemyPtrToAgent())
				Else
					UseSkillEX($SkillbarSlot[$Heart_of_Shadow], GetAgentPtr(-2))
				EndIf
				$lBlocked = 0
				$lHosCount += 1
			EndIf
		Else
			If GetIsDead(-2) Then ExitLoop
			If GetNearestDistance() < $safe_distance Then Survive($safe_distance)
			If $lBlocked > 0 Then
				If TimerDiff($ChatStuckTimer) > 3000 Then    ; use a timer to avoid spamming /stuck
					SendChat("stuck", "/")
					$ChatStuckTimer = TimerInit()
				EndIf
				$lBlocked = 0
				$lHosCount = 0
			EndIf
			If GetNearestDistance() > 1100 Then ; target is far, we probably got stuck.
				If TimerDiff($ChatStuckTimer) > 3000 Then ; dont spam
					SendChat("stuck", "/")
					$ChatStuckTimer = TimerInit()
					RndSleep(GetPing())
				EndIf
			EndIf
		EndIf
	Until GetDistanceToXY($lDestX, $lDestY) < 250 Or $lBlocked > 20 Or GetIsDead(-2) Or TimerDiff($lDeadlock) > 60000
	Return True
EndFunc   ;==>MoveAndSurvive




#EndRegion Movement & Aggro

