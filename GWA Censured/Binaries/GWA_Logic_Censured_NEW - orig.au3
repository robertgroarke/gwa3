Func CacheSkillBar()
	Out("Mapping your skill bar")
	$PressureSpiritSkills = 0 ; (reset in case we map skills more than once)
	Sleep(200)
	For $i = 1 To 8
		$aSkillID = GetSkillbarSkillID($i)
		$SkillbarSlot[$aSkillID] = $i
		$SkillBarCache[$i][$all] = $aSkillID ; we store the skillslots of each skill in the first column
		$SkillBarCache[$i][$ptr] = GetSkillPtr($SkillBarCache[$i][$all])
		$SkillBarCache[$i][$energyreq] = GetEnergyReq($SkillBarCache[$i][$all])
		$SkillBarCache[$i][$adrereq] = MemoryRead($SkillBarCache[$i][$ptr] + 56, 'dword')
		$SkillBarCache[$i][$type] = MemoryRead($SkillBarCache[$i][$ptr] + 12, "long")		; DllStructGetData(GetSkillByID($aSkillID), 'Type')
		$SkillBarCache[$i][$target] = MemoryRead($SkillBarCache[$i][$ptr] + 49, "byte") 	; DllStructGetData(GetSkillByID($aSkillID), 'Target')
		If IsHexSpell($aSkillID) Then $SkillBarCache[$i][$hexes] = $aSkillID
		If IsPressureSkill($aSkillID) Then $SkillBarCache[$i][$pressure] = $aSkillID
		If IsBindingSkill($aSkillID) Then $SkillBarCache[$i][$bind] = $aSkillID
		If IsSpeedBoost($aSkillID) Then $SkillBarCache[$i][$speedBoost] = $aSkillID
		If IsSurvivalSkill($aSkillID) Then $SkillBarCache[$i][$survive] = $aSkillID
		If IsAttackSkill($aSkillID) Then $SkillBarCache[$i][$attackskill] = $aSkillID
		If IsHealSkill($aSkillID) Then $SkillBarCache[$i][$heal] = $aSkillID
		If IsBondSkill($aSkillID) Then $SkillBarCache[$i][$bond] = $aSkillID
		If IsCondRemoveSkill($aSkillID) Then $SkillBarCache[$i][$condremove] = $aSkillID
		If IsHexRemoveSkill($aSkillID) Then $SkillBarCache[$i][$hexremove] = $aSkillID
		If IsEnchantRemoveSkill($aSkillID) Then $SkillBarCache[$i][$enchantremove] = $aSkillID
		If IsRuptSkill($aSkillID) Then $SkillBarCache[$i][$rupt] = $aSkillID
		If IsRuptSkill($aSkillID, True) Then $SkillBarCache[$i][$hardrupt] = $aSkillID
		If IsPrecastSkill($aSkillID) Then $SkillBarCache[$i][$precast] = $aSkillID
		If IsChantSkill($aSkillID) or IsShoutSkill($aSkillID) Then $SkillBarCache[$i][$chantsnshouts] = $aSkillID
		If IsEchoRefrainskill($aSkillID) Then $SkillBarCache[$i][$echoes] = $aSkillID
		If IsPressureSpiritSkill($aSkillID) Then $PressureSpiritSkills += 1
	Next
	If $SkillbarSlot[$Signet_Of_Spirits] > 0 Then $PressureSpiritSkills += 2    ; add 2 spirits for Signet of Spirits
	Out($PressureSpiritSkills & " pressure sprits on your skillbar")
	$Summon_Spirits = $SkillbarSlot[$Summon_Spirits_Luxon] + $SkillbarSlot[$Summon_Spirits_Kurzick]
	Out("Mapping your skill bar - completed")
	;_ArrayDisplay($SkillBarCache)
	Return True
EndFunc   ;==>CacheSkillBar

Func Fight($aAggroRange = 1000, $careful = False) ; Fighting mechanics
	Out("Fighting enemies")
	Local $TimerToGetOut = TimerInit()
	SetEvent("Rupt", "", "", "", "")
	Do
		If $careful Then CancelAll()
		If CanAttack($aAggroRange) Then Attack($BestTargetPtr, True) ; CanAttack() sets $besttarget global variable to best target
		RndSleep(100)
		If $careful Then
			Move(X($BestTargetPtr), Y($BestTargetPtr))
			RndSleep(300)
		EndIf
		UseSkills($aAggroRange, $all)    ; UseSkills resets $besttarget depending on the skills being used
	Until GetNearestDistance() > $aAggroRange Or GetIsDead(-2) Or Wipe() Or TimerDiff($TimerToGetOut) > 240000
	SetEvent("", "", "", "", "")
	PickupLootEx(3000)

EndFunc   ;==>Fight

;~ Use this function to cast all of your skills  or skills of a certain type.
;~ $skilltype: $all = 0, $type, $target, $hexes, $pressure, $bind, $speedBoost, $survive, $attackskill, $heal, $prot, $bond, $condremove, $hexremove, $rupt, $HardRupt, $precast
Func UseSkills($aAggroRange = 1000, $skilltype = $all)
	For $aSkillSlot In $Skillbar
		BossGlow(ID(GetAgentByID(-2)), Random(2, 10, 1))
		If GetIsDead(-2) Or Wipe() = 1 Or GetMapLoading() == 2 Then ExitLoop
		If $SkillBarCache[$aSkillSlot][$skilltype] = "" Then ContinueLoop
		If CanUse($aSkillSlot, $aAggroRange) Then UseSkillEX($aSkillSlot, $BestTargetPtr)
		If GetNearestDistance() > $aAggroRange Then Return
		If $aSkillSlot = 8 Then $aSkillSlot = 1
	Next
EndFunc   ;==>UseSkills

Func Rupt($aCasterID, $aTargetID, $aSkillID, $Activation)
	Local $lCasterPtr = GetAgentPtr($aCasterID), $lTargetPtr = GetAgentPtr($aTargetID), $lSkillPtr = GetSkillPtr($aSkillID)
	Local $lRuptSlot = GetRuptSkillSlot($aSkillID)

	;~ For cancel casting
	If $aCasterID == GetMyID() Then
		;Out("I am casting " & $aSkill_Name[$aSkillID])
		$MyActivation = MemoryRead($lSkillPtr + 60, 'float') * 1000	; storing my activation time into a global variable for the next skill parsing
		$MyAftercast = MemoryRead($lSkillPtr + 64, 'float') * 1000
		$MySkillID = $aSkillID
		$MyTargetID = $aTargetID
		$Aftercast = TimerInit()
		Return
	EndIf

	;~ Cancel casting
	If IsHardRuptSkill($aSkillID) And $aTargetID = GetMyID() Then
		Out($aCasterID & " is interrupting my " & $aSkill_Name[$MySkillID])
		If TimerDiff($Aftercast) > $MyActivation * 1000 Then Return
		If $MyActivation > 250 Then CancelAction()
		$Aftercast = TimerInit()
		Return
	EndIf

	If TimerDiff($Aftercast) < $MyAftercast Then Return
	If GetDistance($aCasterID) > 1200 Or MemoryRead($lCasterPtr + 433, "byte") <> 3 Or GetIsDead() Or GetIsKnocked() Then Return
	; Out("ID: " & $aCasterID & " is casting " & $aSkill_Name[$aSkillID] & " My ID: " & GetMyID())
	If $lRuptSlot > 0 Then
		If MemoryRead($lCasterPtr + 433, "byte") = 3 Then ChangeTarget($lCasterPtr)	; Allegiance
		UseSkillEX($lRuptSlot, $aCasterID)
		If GetIsCasting($lCasterPtr) = 0 Then Out("Interrupted " & $aSkill_Name[$aSkillID] & "!!!")
		; $Aftercast = TimerInit()
	EndIf
EndFunc   ;==>Rupt

Func GetRuptSkillSlot($aSkillID)
	For $aSkillSlot In $Skillbar
		If $SkillBarCache[$aSkillSlot][$rupt] = "" Then ContinueLoop
		If RequiresHardRupt($aSkillID) And $SkillBarCache[$aSkillSlot][$hardrupt] = "" Then ContinueLoop
		If $SkillBarCache[$aSkillSlot][$rupt] = $Signet_of_Clumsiness And Not IsAttackSkill($aSkillID) Then ContinueLoop
		If $SkillBarCache[$aSkillSlot][$energyreq] >  GetEnergy(-2) Then ContinueLoop
		If IsRecharged($aSkillSlot) Then Return $aSkillSlot
	Next
	Return 0
EndFunc   ;==>GetRuptSkillSlot

Func GetIsCasterProfession($aAgent = -2)
	Switch GetPrimaryProfession($aAgent)
		Case $None, $Warrior, $Ranger, $Assassin, $Paragon
			Return False
	EndSwitch
	Return True
EndFunc   ;==>GetIsCasterProfession

Func CanCast($aSkillSlot = 0)
	If GetMapLoading() == 2 Then Disconnected()
	If GetMapLoading() == 0 Then Return
	If GetIsKnocked() Or GetIsDead(-2) Or Wipe = 1 Then Return False
	If $aSkillSlot <> 0 And Not IsRecharged($aSkillSlot) Then Return False    ; aftercast from the Rupt() function
	Local $aType = $SkillBarCache[$aSkillSlot][$type]
	If $aSkillSlot = 0 Then $aType = $attack

	Switch $aType
		Case $Hex, $Spell, $Enchantment, $Well, $Ward, $ItemSpell, $WeaponSpell
			Local $mEffectPtrArray = GetEffectsPtr()
			If $mEffectPtrArray = 0 Then Return True
			For $i = 1 To $mEffectPtrArray[0] - 1
				Switch SkillEffectID($mEffectPtrArray[$i])
					Case $Diversion, $Visions_of_Regret, $Visions_of_Regret_PvP, $Backfire, $Soul_Leech, $Mistrust, $Mistrust_PvP, $Mark_of_Subversion, $Spiteful_Spirit ;;;;;;;;;;;;;;; Can add many other skills $Shame,$Guilt,
						Out("Can't cast")
						Return False
				EndSwitch
		Next
		Case $Attack
			If HasEffect($Ineptitude) + HasEffect($Clumsiness) + HasEffect($Spiteful_Spirit) + HasEffect($Wandering_Eye) + HasEffect($Wandering_Eye_PvP) <> 0 Then
				Out("Can't Attack")
				Return False
			EndIf
		Case $Ritual, $Signet, $Glyph, $Shout, $Preparation, $Trap, $Chant, $EchoRefrain, $Disguise
			If HasEffect($Diversion) Then Return False
		Case $Shout, $Chant
			If HasEffect($Well_of_Silence) Then Return False
		Case $Signet
			If HasEffect($Ignorance) Then Return False
	EndSwitch
	Return True

EndFunc   ;==>CanCast

Func CanAttack($aRange = 1320)
	$BestTargetPtr = GetBestTargetPtr($aRange)
	; Out(DllStructGetData($besttarget, 'ID') & " - My ID: " & ID(-2))
	If $BestTargetPtr = 0 Or IsFrostWorm($BestTargetPtr) Then Return False
	If CanCast() Then Return True
	Return False
EndFunc   ;==>CanAttack

Func GetBestTargetBySkillSlot($aSkillSlot, $aAggroRange = 1320)
	$MyPtr = GetAgentPtr(-2)
	Switch $SkillBarCache[$aSkillSlot][$target]
		Case 0	; self
			If $SkillBarCache[$aSkillSlot][$type] == $Ward And GetDistance(GetNearestEnemyPtrToAgent()) > $aAggroRange Then Return False
;~ 			If $SkillBarCache[$aSkillslot][$precast] == 0 And GetDistance(GetNearestEnemyToAgent(-2)) > $aAggroRange Then Return False
			$BestTargetPtr = $MyPtr
		Case 1	; spirit, minion
			$BestTargetPtr = GetNearestSpiritPtrToAgent()
		Case 3	; ally
			If $SkillBarCache[$aSkillSlot][$condremove] <> "" Then
				$BestTargetPtr = MostCondsAllyPtr()
			ElseIf $SkillBarCache[$aSkillSlot][$hexremove] <> "" Then
				Switch $SkillBarCache[$aSkillSlot][$hexremove]
					Case $Hex_Eater_Signet, $Hex_Eater_Vortex, $Shatter_Hex, $Smite_Hex
						$BestTargetPtr = GetMostBalledHexedAlly()
					Case Else
						$BestTargetPtr = MostHexedAllyPtr()
				EndSwitch
			ElseIf $SkillBarCache[$aSkillSlot][$precast] <> "" Then
				$BestTargetPtr = $MyPtr
			ElseIf $SkillBarCache[$aSkillSlot][$survive] <> "" Then
				$BestTargetPtr = $MyPtr
			ElseIf $SkillBarCache[$aSkillSlot][$echoes] <> "" Then
				$BestTargetPtr = NeedEchoAlly($SkillBarCache[$aSkillSlot][$echoes])
			Else
				$BestTargetPtr = GetLowestAlly()
			EndIf
		Case 4	; other ally
			If $SkillBarCache[$aSkillSlot][$condremove] <> "" Then
				$BestTargetPtr = MostCondsAllyPtr(True)
			ElseIf $SkillBarCache[$aSkillSlot][$hexremove] <> "" Then
				$BestTargetPtr = MostHexedAllyPtr(True)
			ElseIf $SkillBarCache[$aSkillSlot][$precast] <> "" Then
				$BestTargetPtr = $MyPtr
			ElseIf $SkillBarCache[$aSkillSlot][$survive] <> "" Then
				$BestTargetPtr = $MyPtr
			ElseIf $SkillBarCache[$aSkillSlot][$echoes] <> "" Then
				$BestTargetPtr = NeedEchoAlly($SkillBarCache[$aSkillSlot][$echoes])
			Else
				$BestTargetPtr = GetLowestAlly(True)
			EndIf

		Case 5	; enemy,
			If $SkillBarCache[$aSkillSlot][$hexes] <> "" Then
				$BestTargetPtr = GetNoHexEnemy($aAggroRange) = 0
				If $BestTargetPtr = 0 Then $BestTargetPtr = GetBestTargetPtr($aAggroRange)
			ElseIf $SkillBarCache[$aSkillSlot][$enchantremove] <> "" Then
				$BestTargetPtr = GetBalledEnchantedEnemy($aAggroRange)
			ElseIf $SkillBarCache[$aSkillSlot][$attackskill] <> "" Then
				$BestTargetPtr = GetBestMeleeTarget()
			ElseIf $SkillBarCache[$aSkillSlot][$rupt] <> "" Then
				$BestTargetPtr = GetMostBalledCastingEnemy($aAggroRange)    ; finds only enemies that are casting a spell
			Else
				$BestTargetPtr = GetBestTargetPtr($aAggroRange)
			EndIf
		Case 6	; dead ally
			$BestTargetPtr = GetNearestDeadAllyPtrToAgent()
		Case 14	; spirit, minion
			$BestTargetPtr = GetNearestMinionPtrToAgent()
	EndSwitch

	If $BestTargetPtr <> 0 Then Return $BestTargetPtr
	Return 0

EndFunc   ;==>GetBestTargetBySkillSlot

;~ add tests if a skill can be used based on them belonging to one or more skill types; can also be used to cast other skills before the actual skill
Func CanUse($aSkillSlot, $aAggroRange = 1320)
	Local $ZephyrEffect = $SkillBarCache[$aSkillSlot][$energyreq] * 30 / 100
	Local $ZephyrAddition = $SkillBarCache[$aSkillSlot][$energyreq] + $ZephyrEffect

	If $aSkillSlot = "" Then Return
	If Not CanCast($aSkillSlot) Then Return False
	If GetBestTargetBySkillSlot($aSkillSlot, $aAggroRange) = 0 Then Return False        ; This sets §besttarget global variable to the best target for the skillslot if valid
	If Not IsRecharged($aSkillSlot) Then Return False
	If GetEnergy(-2) < $SkillBarCache[$aSkillSlot][$energyreq] Then Return False
	If HasEffect($Quickening_Zephyr) And GetEnergy(-2) < $ZephyrAddition Then Return False
	If $SkillBarCache[$aSkillSlot][$adrereq] <> 0 And GetSkillbarSkillAdrenaline($aSkillslot) < $SkillBarCache[$aSkillSlot][$adrereq]  Then Return False

;~ BINDING RITUALS
	If $SkillBarCache[$aSkillSlot][$bind] <> "" Then
		Switch $SkillBarCache[$aSkillSlot][$bind]     ; binding ritual skills
			Case $Summon_Spirits_Kurzick, $Summon_Spirits_Luxon
				If NumberOfPressureSpirits() = 0 Or GetNumberOfEnemies(1320) = 0 Then Return False
		EndSwitch
	EndIf

;~ SURVIVAL SKILLS
	If $SkillBarCache[$aSkillSlot][$survive] <> "" Then
		Switch $SkillBarCache[$aSkillSlot][$survive]
			Case $I_Am_Unstoppable
				If GetEffectTimeRemaining($Shadow_Form) > 5000 And Not GetIsKnocked(-2) Then Return False
			Case $Glyph_of_Swiftness
				If GetEffectTimeRemaining($Shadow_Form) > 5000 Then Return False
				If GetSkillbarSkillRecharge($SkillbarSlot[$Shadow_Form]) > 5000 Then Return False
			Case $Shadow_Form
				If GetEffectTimeRemaining($Shadow_Form) > 5000 Then Return False
				If GetEffectTimeRemaining($Glyph_of_Swiftness) = 0 Then Return False
			Case $Shroud_Of_Distress
				If GetHP(-2) > 0.9 Then Return False
				If GetEffectTimeRemaining($Shroud_Of_Distress) > 5000 Then Return False
			Case $Shadow_Sanctuary_Luxon, $Shadow_Sanctuary_Kurzick, $Shadow_Refuge
				If GetHP(-2) > 0.7 Then Return False
			Case $Heart_of_Shadow
				If GetHP(-2) > 0.5 Then Return False
			Case $Mystic_Regeneration
				If GetEffectTimeRemaining($Mystic_Regeneration) < 4000 Then Return True
			Case $Shield_of_Judgment
				If GetEffectTimeRemaining($Shielding_Hands) < 4500 And GetEffectTimeRemaining($Shield_of_Absorption) < 4500 Then Return False

		EndSwitch
	EndIf

;~ PRESSURE SKILLS
	If $SkillBarCache[$aSkillSlot][$pressure] <> "" Then
		Switch $SkillBarCache[$aSkillSlot][$pressure]
			Case $Finish_Him
				If DllStructGetData(GetCurrentTarget(), 'HP') > 0.45 Then Return False
		EndSwitch
	EndIf

;~ SPEEDBOOST SKILLS
	If $SkillBarCache[$aSkillSlot][$speedBoost] <> "" Then
		Switch $SkillBarCache[$aSkillSlot][$speedBoost]
			Case $Dwarven_Stability
				If GetEffectTimeRemaining(GetEffect($Dwarven_Stability)) > 3000 Then Return False
			Case $Dark_Escape
				If GetEffectTimeRemaining(GetEffect($Dwarven_Stability)) = 0 Then Return False
			Case $Dash
				If GetEffectTimeRemaining(GetEffect($Dwarven_Stability)) = 0 Then Return False
		EndSwitch
	EndIf

;~ PRECAST SKILLS
	If $SkillBarCache[$aSkillSlot][$precast] <> "" Then
		Switch $SkillBarCache[$aSkillSlot][$precast]
			Case $Balthazars_Spirit
				If GetEffectTimeRemaining(GetEffect($Balthazars_Spirit)) <> 0 Then Return False
		EndSwitch
	EndIf

;~ HEAL SKILLS
	If $SkillBarCache[$aSkillSlot][$heal] <> "" Then
		$lowestally = GetLowestAlly()
		Switch $SkillBarCache[$aSkillSlot][$heal]
			Case Else
				If IsHealSkill($SkillBarCache[$aSkillSlot][$heal]) And GetHP($lowestally) > 0.8 Then Return False
				If IsSelfHealSkill($SkillBarCache[$aSkillSlot][$heal]) And GetHP(-2) > 0.8 Then Return False
		EndSwitch
	EndIf

;~ CONDITION REMOVE SKILLS
	If $SkillBarCache[$aSkillSlot][$condremove] <> "" Then
		If RequiresCondition($SkillBarCache[$aSkillSlot][$condremove]) And Not GetHasCondition($MostConditionedAlly) Then Return False
		$lowestally = GetLowestAlly()
		Switch $SkillBarCache[$aSkillSlot][$heal]
			Case $Martyr
				If GetNumberOfConditionedAllies() = 0 Then Return False
		EndSwitch
	EndIf

;~ HEX REMOVE SKILLS
	If $SkillBarCache[$aSkillSlot][$hexremove] <> "" Then
		$MostHexedAlly = MostHexedAllyPtr()

		If RequiresHex($SkillBarCache[$aSkillSlot][$hexremove]) And Not GetHasHex($BestTargetPtr) Then Return False

		Switch $SkillBarCache[$aSkillSlot][$hexremove]
			Case $Divert_Hexes, $Cure_Hex                                                         ;Heal and remove hex (me and ally)
				If GetHealth($MostHexedAlly) > 0.8 Then Return False
		EndSwitch
	EndIf

;~  Chants And SHOUTS
	If $SkillBarCache[$aSkillSlot][$chantsnshouts] <> "" Then
		Switch $SkillBarCache[$aSkillSlot][$chantsnshouts]
			Case $Theyre_on_Fire
				If GetEffectTimeRemaining(GetEffect($Theyre_on_Fire)) <> 0 Then Return False
		EndSwitch
	EndIf

;~	Echoes
	If $SkillBarCache[$aSkillSlot][$echoes] <> "" Then
		Switch $SkillBarCache[$aSkillSlot][$echoes]
			Case $Aggressive_Refrain
				If GetEffectTimeRemaining(GetEffect($Aggressive_Refrain)) <> 0 Then Return False
		EndSwitch
	EndIf

;~ INTERRUPTS
;	If $SkillBarCache[$aSkillSlot][$rupt] <> "" Then Return False ; managed through event system

	Switch $SkillBarCache[$aSkillSlot][$all]
		Case $Ether_Signet
			If GetEnergy(-2) > 4 Then Return False
	EndSwitch

	Return True
EndFunc   ;==>CanUse

#Region Agent Controls

;~Description: Returns the party member with the lowest HP
Func GetLowestAlly($excludeself = False)
	Local $lLowestally, $lLowestHP = 1000
	Local $lHP
	Local $lAgentArray = GetAgentArray(0xDB)

	For $i = 1 To $lAgentArray[0]
		If DllStructGetData($lAgentArray[$i], 'Allegiance') <> 1 Then ContinueLoop
		If DllStructGetData($lAgentArray[$i], 'HP') <= 0 Then ContinueLoop
		If BitAND(DllStructGetData($lAgentArray[$i], 'Effects'), 0x0010) > 0 Then ContinueLoop
		If $excludeself And ID($lAgentArray) = -2 Then ContinueLoop

		$lHP = GetHealth($lAgentArray[$i])
		If $lHP < $lLowestHP Then
			$lLowestally = $lAgentArray[$i]
			$lLowestHP = $lHP
		EndIf
	Next

	Return $lLowestally
EndFunc   ;==>GetLowestAlly

;~Description: Returns the enemy with the lowest HP
Func GetLowestEnemy($aRange = 1320)
	GetBestTargetPtr($aRange)
	Return $LowestEnemy
EndFunc   ;==>GetLowestEnemy

;~Description: Returns the first enemy with no Hexes
Func GetNoHexEnemy($aRange = 1320)
	Return GetBestTargetPtr($aRange, False, True)
EndFunc   ;==>GetNoHexEnemy

Func GetBalledEnchantedEnemy($aRange)
	Return GetBestTargetPtr($aRange, False, False, True)
EndFunc   ;==>GetBalledEnchantedEnemy

Func GetMostBalledCastingEnemy($aRange = 1320)
	Return GetBestTargetPtr($aRange, True)
EndFunc   ;==>GetMostBalledCastingEnemy

Func GetMostBalledHexedEnemy($aRange = 1320)
	Return GetBestTargetPtr($aRange, False, True)
EndFunc   ;==>GetMostBalledHexedEnemy

Func GetBestTargetAlly($DistanceToSelf = 1320, $hexedonly = True, $otherally = False)
	Local $lBestTargetPtr, $lDistance, $lLowestSum = 100000000
	Local $lAgentPtrArray = GetAgentPtrArray(4, 0xDB, 1)

	For $i = 1 To $lAgentPtrArray[0]
		Local $lSumDistances = 0
		If $hexedonly And Not GetHasHex($lAgentPtrArray[$i]) Then ContinueLoop
		If $otherally And DllStructGetData($lAgentPtrArray[$i], 'ID') = GetMyID() Then ContinueLoop

		For $J = 1 To $lAgentPtrArray[0]
			If $lAgentPtrArray[$J] = $lAgentPtrArray[$i] Then ContinueLoop
			$lDistance = GetDistance($lAgentPtrArray[$i], $lAgentPtrArray[$J])
			$lSumDistances += $lDistance
		Next
		If $lSumDistances < $lLowestSum Then
			$lLowestSum = $lSumDistances
			$lBestTargetPtr = $lAgentPtrArray[$i]
		EndIf
	Next
	Return $lBestTargetPtr
EndFunc   ;==>GetBestTargetAlly

Func GetMostBalledHexedAlly($aRange = 1320)
	Return GetBestTargetAlly($aRange, True)
EndFunc   ;==>GetMostBalledHexedAlly

Func NeedEchoAlly($aSkillID)
	Local $lHeroID

	If GetAttributeByID($Leadership, True) < 20 and $aSkillID == $Heroic_Refrain Then Return GetAgentByID(-2)
	For $i = 1 to GetPartySize() - 1
		$lHeroID = GetHeroID($i)
		If GetIsDead($lHeroID) Then ContinueLoop                                  ; exclude agents that do not have the effect
		If Not IsDllStruct(GetEffect($aSkillID, $i)) Then Return GetAgentByID($lHeroID)
	Next
EndFunc   ;==>NeedEchoAlly

;~Description: Returns the ally with the most Conditions on them
Func MostCondsAllyPtr($excludeself = False)
    Local $MostConditionedAlly
    Local $lMostConditions = 0

    For $aHeroNumber = 0 To GetPartySize()-1
       If $excludeself = True And $aHeroNumber = 0 Then ContinueLoop

        Local $lcountConditions = 0
        Local $mEffectPtrArray = GetEffectsPtr(0, $aHeroNumber)

		If $mEffectPtrArray = 0 Then ContinueLoop
        For $j = 1 To $mEffectPtrArray[0]
           If MemoryRead(GetSkillPtr(SkillEffectID($mEffectPtrArray[$j])) + 12, 'long') = $Condition Then  $lcountConditions += 1
		Next

        If $lcountConditions > $lMostConditions Then
            $MostConditionedAlly = GetHeroID($aHeroNumber)
            $lMostConditions = $lcountConditions
        EndIf
	Next

    Return $MostConditionedAlly
EndFunc   ;==>MostCondsAllyPtr

;~Description: Returns the ally with the most Hexes on them
Func MostHexedAllyPtr($excludeself = False)
	Local $lMostHexedally
	Local $lMostHexes = 0

	For $aHeroNumber = 0 To GetPartySize()-1
		If $excludeself = True And $aHeroNumber = 0 Then ContinueLoop

		Local $lcountHexes = 0
		Local $mEffectPtrArray = GetEffectsPtr(0, $aHeroNumber)

		If $mEffectPtrArray = 0 Then ContinueLoop
		For $j = 1 To $mEffectPtrArray[0]
           If MemoryRead(GetSkillPtr(SkillEffectID($mEffectPtrArray[$j])) + 12, 'long') = $Hex Then  $lcountHexes += 1
		Next

		If $lcountHexes > $lMostHexes Then
			$lMostHexedally = GetHeroID($aHeroNumber)
			$lMostHexes = $lcountHexes
		EndIf
	Next

	Return $lMostHexedally
EndFunc   ;==>MostHexedAllyPtr


#EndRegion Agent Controls

Func Survive($aAggroRange = 1500)
	If GetIsDead(-2) Then Return
	If CanUse($SkillbarSlot[$I_Am_Unstoppable]) Then UseSkillEX($SkillbarSlot[$I_Am_Unstoppable])
	If CanUse($SkillbarSlot[$Glyph_of_Swiftness]) Then UseSkillEX($SkillbarSlot[$Glyph_of_Swiftness])
	If CanUse($SkillbarSlot[$Shadow_Form]) Then UseSkillEX($SkillbarSlot[$Shadow_Form])

	If CanUse($SkillbarSlot[$Protective_Spirit]) Then UseSkillEX($SkillbarSlot[$Protective_Spirit])
	If CanUse($SkillbarSlot[$Shielding_Hands]) Then UseSkillEX($SkillbarSlot[$Shielding_Hands])
;~ 	If CanUse($SkillbarSlot[$Spirit_Bond]) Then UseSkillEX($SkillbarSlot[$Spirit_Bond])

	For $aSkillSlot In $Skillbar
		If GetIsDead(-2) Then ExitLoop
		If GetHP(-2) < 0.9 And TimerDiff($MysticTimer) > 500 And UBound($HeroHeals) <> 0 Then
			UseHeroSkill($HeroHeals[$HealCount][1], $HeroHeals[$HealCount][2], 0)
			$MysticTimer = TimerInit()
			$HealCount += 1
			If $HealCount > UBound($HeroHeals) - 1 Then $HealCount = 0
		EndIf

		If $SkillBarCache[$aSkillSlot][$survive] = "" Then ContinueLoop
		If CanUse($aSkillSlot, $aAggroRange) Then UseSkillEX($aSkillSlot, $BestTargetPtr)
	Next
EndFunc   ;==>Survive

Func Precast($aAggroRange = $compass_range, $precastspirits = True)
	If $precastspirits Then PrecastWardsAndSpirits()
	If CanUse($SkillbarSlot[$Ebon_Battle_Standard_Of_Honor], $longbow_range) Then UseSkillEX($SkillbarSlot[$Ebon_Battle_Standard_Of_Honor])
	If CanUse($SkillbarSlot[$Summon_Spirits_Luxon]) Then UseSkillEX($SkillbarSlot[$Summon_Spirits_Luxon])
	If CanUse($SkillbarSlot[$Painful_Bond]) Then UseSkillEX($SkillbarSlot[$Painful_Bond], $BestTargetPtr)
	If CanUse($SkillbarSlot[$Boon_Of_Creation]) Then UseSkillEX($SkillbarSlot[$Boon_Of_Creation])

EndFunc   ;==>Precast

Func SpreadChants()
	For $aSkillSlot In $Skillbar
		If $SkillBarCache[$aSkillSlot][$echoes] = "" And $SkillBarCache[$aSkillSlot][$chantsnshouts] = "" Then ContinueLoop
		If CanUse($aSkillSlot) Then UseSkillEX($aSkillSlot, $BestTargetPtr)
	Next
EndFunc   ;==>SpreadChants

Func KeepUpTaoF()
	If CanUse($SkillbarSlot[$Theyre_on_Fire]) Then UseSkillEX($SkillbarSlot[$Theyre_on_Fire])
EndFunc   ;==>KeepUpHR

Func Precastupkeep()
	For $aSkillSlot In $Skillbar
		If $SkillBarCache[$aSkillSlot][$precast] = "" Then ContinueLoop
		If CanUse($aSkillSlot) Then UseSkillEX($aSkillSlot, -2)
	Next
EndFunc   ;==>Precastupkeep

Func SpeedBoost()
	For $aSkillSlot In $Skillbar
		If $SkillBarCache[$aSkillSlot][$speedBoost] = "" Then ContinueLoop
		If CanUse($aSkillSlot) Then UseSkillEX($aSkillSlot, $BestTargetPtr)
	Next
EndFunc   ;==>SpeedBoost

Func Bind($aAggroRange = $longbow_range)
	UseSkills($aAggroRange, $bind)
EndFunc   ;==>Bind

Func Pressure($aAggroRange = $longbow_range)
	UseSkills($aAggroRange, $pressure)
EndFunc   ;==>Pressure

Func AttackEnemies($aAggroRange = $longbow_range)
	UseSkills($aAggroRange, $attackskill)
EndFunc   ;==>AttackEnemies

Func Heal($aAggroRange = $spellcasting_range)
	Out("Using heal skills")
	UseSkills($aAggroRange, $prot)
	UseSkills($aAggroRange, $condremove)
	UseSkills($aAggroRange, $hexremove)
	UseSkills($aAggroRange, $heal)

EndFunc   ;==>Heal

Func Interrupt($aAggroRange = $bowpull_range)
	Out("Using interrupt skills")
	UseSkills($aAggroRange, $interrupt)
EndFunc   ;==>Interrupt

Func Defend($aAggroRange = $spellcasting_range)
	Out("Using defensive skills")
	UseSkills($aAggroRange, $defend)
EndFunc   ;==>Defend

#EndRegion Cast Functions

#Region Skill Controls

Func IsSurvivalSkill($aSkillID)    ; to be expanded based on your needs
	Switch $aSkillID
		Case $I_Am_Unstoppable, $Shadow_Form, $Shroud_of_Distress, $Glyph_of_Swiftness, $Shadow_Sanctuary_Luxon, $Shadow_Sanctuary_Kurzick _
				, $Heart_of_Shadow, $Way_Of_The_Master, $Shadow_Refuge, $Protective_Spirit, $Shield_of_Absorption, $Shielding_Hands _
				, $Mystic_Regeneration, $Shield_of_Judgment, $Spirit_Bond, $Zealots_Fire
			Return True
	EndSwitch
	Return False
EndFunc   ;==>IsSurvivalSkill

Func IsPrecastSkill($aSkillID) ; priority skills used first in a fight, to be expanded based on your needs
	If IsPressureSpiritSkill($aSkillID) Then Return True
	Switch $aSkillID
		Case $Balthazars_Spirit, $Blessed_Aura, $Boon_Of_Creation
			Return True
	EndSwitch
	If IsSelfPrehealSkill($aSkillID) Then Return True
	If IsDisguiseskill($aSkillID) Then Return True
	If MemoryRead(GetSkillPtr($aSkillID) + 12, "long") = $Ward Then Return True ; Type
	Return False
EndFunc   ;==>IsPrecastSkill

Func IsPressureSkill($aSkillID) ; to be expanded based on your needs

	If IsConditionSpell($aSkillID) Then Return True
	If IsHexSpell($aSkillID) Then Return True
	Switch $aSkillID
		Case $Ebon_Vanguard_Assassin_Support, $Ebon_Battle_Standard_Of_Honor, $Finish_Him, $Dark_Pact
			Return True
	EndSwitch
	Return False
EndFunc   ;==>IsPressureSkill

Func NumberOfRechargedSkills()
	Local $lRechargedSkills = 0
	For $i = 1 To 8
		If GetSkillbarSkillRecharge($i) == 0 Then
			$lRechargedSkills += 1
		EndIf
	Next
	Return $lRechargedSkills
EndFunc   ;==>NumberOfRechargedSkills

Func SkillSleep($nSkillID)
	$aSkill = GetSkillByID($nSkillID)
	$nActivationTime = DllStructGetData($aSkill, 'Activation') * 1000
	Sleep($nActivationTime + 100)
EndFunc   ;==>SkillSleep

Func GetAvailableRezz()        ; returns the number of available rezz skills excluding dead party members, use to force move, aggro and death when no more rezz is available
	Local $aHeroRezzSkills = 0
	For $aHeroNumber = 1 To GetHeroCount()
		If GetIsDead(GetHeroID($aHeroNumber)) Or GetAgentByID(GetHeroID($aHeroNumber)) = 0 Then ContinueLoop
		For $aSkillSlot = 1 To 8
			$aSkill = GetSkillbarSkillID($aSkillSlot, $aHeroNumber)
			If IsResSkill($aSkill) Then $aHeroRezzSkills += 1
		Next
	Next
	Return $aHeroRezzSkills        ;==> GetAvailableRezz
EndFunc   ;==>GetAvailableRezz


Func IsResSkill($aSkill)
	Switch $aSkill
		Case $By_Urals_Hammer, $We_Shall_Return, $Death_Pact_Signet, $Eternal_Aura, $Flesh_of_My_Flesh, $Junundu_Wail, $Light_of_Dwayna, $Lively_Was_Naomei, $Rebirth, $Renew_Life, _
				$Restoration, $Restore_Life, $Resurrect, $Resurrection_Chant, $Resurrection_Signet, $Signet_of_Return, $Sunspear_Rebirth_Signet, $Unyielding_Aura, $Vengeance
			Return True
	EndSwitch
	Return False
EndFunc   ;==>IsResSkill

Func IsTargetedHealSkill($aSkill)    ; incomplete list, add based on your needs
	Switch $aSkill
		Case $Gift_of_Health, $Heal_Other, $Healing_Ribbon, $Healing_Ring, $Healing_Seed, $Infuse_Health, $Jameis_Gaze, $Mend_Body_and_Soul, $Mystic_Healing _
				, $Spirit_Light, $Spirit_Transfer, $Word_of_Healing
			Return True
	EndSwitch
	Return False
EndFunc   ;==>IsTargetedHealSkill

Func IsPartyHealSkill($aSkill)    ; incomplete list, add based on your needs
	Switch $aSkill
		Case $Divine_Healing, $Heal_Party, $Heavens_Delight, $Protective_Was_Kaolai, $Mystic_Healing, $Mystic_Healing_PvP
			Return True
	EndSwitch
	Return False
EndFunc   ;==>IsPartyHealSkill

Func IsSelfPrehealSkill($aSkill)    ; contains only instant, non condititional, self-targeted heals
	Switch $aSkill
		Case $Healing_Breeze, $Healing_Hands, $Mending, $Patient_Spirit, $Restful_Breeze, $Spirit_Bond, $Vigorous_Spirit _                        ; Monk Skills
				, $Conviction, $Faithful_Intervention, $Mystic_Regeneration, $Mystic_Vigor, $Pious_Renewal, $Vital_Boon, $Watchful_Intervention _ ; Dervish Skills
				, $Feigned_Neutrality, $Shadow_Refuge, $Shadow_Sanctuary_Luxon, $Shadow_Sanctuary_Kurzick, $Shroud_of_Distress _                  ; Assassin Skills
				, $Healing_Spring, $Troll_Unguent _                                                                                               ; Ranger Skills
				, $Blood_Renewal, $Hexers_Vigor                                                                                                   ; Necro Skills
			Return True
	EndSwitch
	Return False
EndFunc   ;==>IsSelfPrehealSkill

Func IsBondSkill($aSkill)
	Switch $aSkill
		Case $Balthazars_Spirit, $Essence_Bond, $Life_Barrier, $Life_Bond, $Mending, $Protective_Bond, $Purifying_Veil, $Retribution, $Strength_of_Honor, $Succor
			Return True
	EndSwitch
	Return False
EndFunc   ;==>IsBondSkill

;~ Tests if a skill is a condition removal skill - to be expanded
Func IsCondRemoveSkill($aSkill)
	Switch $aSkill
		Case $mend_ailment, $purge_conditions, $mending_touch, $Mend_Body_and_Soul, $Spotless_Soul
			Return True
	EndSwitch
	If IsHexAndConditionRemoveSkill($aSkill) Then Return True
	Return False
EndFunc   ;==>IsCondRemoveSkill

;~ Tests if a skill is a hex removal skill
Func IsHexRemoveSkill($aSkill)
	Switch $aSkill
		Case $Smite_Hex, $Divert_Hexes, $Cure_Hex, $Hex_Eater_Vortex, $Shatter_Hex, $Reverse_Hex, $Remove_Hex, $Expel_Hexes, $Inspired_Hex, $Revealed_Hex, $Spotless_Mind, $Convert_Hexes, $Deny_Hexes, _ ; remove hex (me and ally)
				$Hex_Eater_Signet, $Withdraw_Hexes, $Hexbreaker_Aria, $holy_veil, $Pious_Restoration
			Return True
	EndSwitch
	If IsHexAndConditionRemoveSkill($aSkill) Then Return True
	Return False
EndFunc   ;==>IsHexRemoveSkill

Func IsHexAndConditionRemoveSkill($aSkillID)
	Switch $aSkillID
		Case $Peace_and_Harmony, $Empathic_Removal, $Blessed_Light, $Contemplation_of_Purity, $Purge_Signet, $Signet_of_Removal
			Return True
	EndSwitch
	Return False
EndFunc   ;==>IsHexAndConditionRemoveSkill

Func IsSpeedBoost($aSkill)
	Switch $aSkill
		Case $Dwarven_Stability    ; used to potentiate running, to be used before stances
			Return True
		Case $Illusion_of_Haste, $Windborne_Speed, $Armor_of_Mist, $Storm_Djinns_Haste, $Rush, $Sprint, $Charge, $Bulls_Charge, $Dodge, $Escape, $Storm_Chaser, $Run_as_One, _
				$Burning_Speed, $Retreat, $Gust, $Shadow_of_Haste, $Torch_Hex, $Torch_Degeneration_Hex, $Dark_Escape, $Dash, $Zojuns_Haste, $Flame_Djinns_Haste, _
				$Enraging_Charge, $Lyssas_Haste, $Avatar_of_Balthazar, $Enchanted_Haste, $Pious_Haste, $Whirling_Charge, $Godspeed, $Make_Haste, $Fall_Back, $Incoming, $Onslaught, _
				$Featherfoot_Grace, $Harriers_Haste, $Hasty_Refrain, $Soldiers_Speed, $Drunken_Master, $Ursan_Roar, $Volfen_Pounce, $Escape_PvP, $Charging_Strike, _
				$Battle_Rage, $Natural_Stride, $Storms_Embrace, $Junundu_Tunnel, $Flee, $HYAHHHHH, $Ursan_Force, $Incoming_PvP, $Its_Just_a_Flesh_Wound, $Fall_Back_PvP, _
				$Call_of_Haste, $Call_of_Haste_PvP, $Lead_the_Way, $Fleeting_Stability, $Illusion_of_Haste_PvP, $Mindbender, $Rampage_as_One
			Return True
		Case $Heroic_Refrain, $To_the_Limit	; ensures Heroic refrain is being ramped up / maintained outside of aggro
			Return True
	EndSwitch
	Return False
EndFunc   ;==>IsSpeedBoost

Func IsSpeedAttackBoost($aSkill)
	Switch $aSkill
		Case $Primal_Rage, $Experts_Dexterity, $Experts_Dexterity_PvP, $Soldiers_Stance_PvP, $Soldiers_Stance, $Dwarven_Battle_Stance, $Heart_of_Fury, $Heart_of_Fury_PvP, $Pious_Fury_PvP, $Pious_Fury, $Flail, _
				$Burst_of_Aggression, $Tiger_Stance, $Flurry, $Tigers_Fury, $Bestial_Fury, $Berserker_Stance, $Lightning_Reflexes, $Lightning_Reflexes_PvP, $Hekets_Rampage, $Frenzy, $Volfen_Bloodlust, $Volfen_Bloodlust, _
				$I_Will_Avenge_You, $Aggressive_Refrain, $Critical_Agility, $Drunken_Master, $Feral_Aggression, $Never_Rampage_Alone, $Onslaught, $Predatory_Bond, $Rampage_as_One, $Rapid_Fire, $Soldiers_Fury, _
				$Weapon_of_Aggression, $Way_Of_the_Assassin
			Return True
	EndSwitch
	Return False
EndFunc   ;==>IsSpeedAttackBoost

; Returns whether a skill is a hex spell
Func IsHexSpell($aSkill)
	If IsPtr($aSkill) <> 0 Then
		Return MemoryRead($aSkill + 12, "long") = $Hex
	ElseIf IsDllStruct($aSkill) <> 0 Then
		Return DllStructGetData($aSkill, "Type") = $Hex
	Else
		Return MemoryRead(GetSkillPtr($aSkill) + 12, "long") = $Hex
	EndIf
EndFunc   ;==>IsHexSpell

; Returns whether a skill is a condition spell
Func IsConditionSpell($aSkill)
