			;If GetItemModelID($lItemPtr) <> 2415 Then ContinueLoop ;  Great Conch only
			If $lItemPtr = 0 Or Not CanSell($lItemPtr) Then ContinueLoop
			If HasUsefulMod($lItemPtr) Then
				;ContinueLoop ; temporary until we figure out why we are getting dced
				$aMod = @extended
				;Seem to be getting dced here...
				Out("Salvaging mod...")
				StartSalvage($lItemPtr, False)        ; make sure it selects the right kit
				PingSleep(50)
				SalvageMod($aMod)
				Local $ldeadlock = TimerInit()
				Do
					Sleep(10)
				Until TimerDiff($ldeadlock) > (500 + GetPing()) Or DllStructGetData($lItemPtr, "ID") = 0 Or IAmDisconnected() = True
				ControlSend(GetWindowHandle(), '', '', '{Enter}')
				PingSleep(200)
			Else
				Local $lRarity = GetRarity($lItemPtr)
				;Out("Enter Else")
				; Salvage Rare Weapons only
				If $lRarity = $Rarity_GOLD Then
					local $atype = MemoryRead(GetItemPtr($lItemPtr) + 32, "byte")
					Switch $atype
						Case 2, 5, 12, 15, 22, 24, 26, 27, 32, 35, 36
							Out("Salvage Weapon for Materials")
							StartSalvage($lItemPtr, True) ;True
							Sleep(GetPing())
							SalvageMaterials()
							Local $ldeadlock = TimerInit()
							Do
								Sleep(10)
							Until TimerDiff($ldeadlock) > (500 + GetPing()) Or DllStructGetData($lItemPtr, "ID") = 0 Or IAmDisconnected() = True
							;ControlSend(GetWindowHandle(), '', '', '{Enter}')
							;PingSleep(200)
					EndSwitch
				EndIf
			EndIf
		Next
	Next
EndFunc

Func SalvageSellItems()
	Local $itemArray[0]
	Merchant()
	If FindIDKit() < 50 Then BuySuperiorIDKit()
	If FindSalvageKit() < 50 Then BuyItem(4, 1, 2000)
	IdentifyBags()
	DepositGold(800000)
	If GetGoldCharacter() < 2500 Then WithdrawGold(3000 - GetGoldCharacter())
	For $bag = 1 To $UseBags
		$lBagPtr = GetBagPtr($bag)
		If $lBagPtr = 0 Then ContinueLoop
		For $slot = 1 To Memoryread($lBagPtr + 32, "long")
			$lItemPtr = GetItemPtrBySlot($bag, $slot)
			If $lItemPtr = 0 Or Not CanSell($lItemPtr) Then ContinueLoop
			If HasUsefulMod($lItemPtr) Then
				$aMod = @extended
				; Out("Salvaging mod...")
				StartSalvage($lItemPtr)        ; make sure it selects the right kit
				PingSleep(50)
				SalvageMod($aMod)
			Else
				SellItem($lItemPtr)
			EndIf
		Next
	Next
EndFunc

Func HasUsefulMod($aItem)
	Local $Mods[184][4]
	If FileExists($MOD_INI_PATH) Then
		$array_weaponmods_ini = _iniToArray("Mod_Settings.ini", "array_weaponmods")
	Else
		$array_weaponmods_ini = $array_weaponmods
	EndIf

	$aModStruct = GetModStruct($aItem)
	$atype = MemoryRead(GetItemPtr($aItem) + 32, "byte")

	Switch $atype
		Case 0
			Out("Type Salvage")
			For $i = 0 To UBound($array_armormods) - 1
				If $array_armormods[$i][4] = 1 And StringInStr($aModStruct, $array_armormods[$i][3]) > 0 Then
					Out("Item has useful mod " & $array_armormods[$i][0])
					SetExtended($array_armormods[$i][2])
					Return True
				EndIf
			Next

		Case 2, 5, 12, 15, 22, 24, 26, 27, 32, 35, 36
			; Type Weapon
			For $j = 0 To 10
				For $i = 0 To UBound($array_weaponmods) - 1
					If $atype = $TYPE_ID[$j] And StringInStr($aModStruct, $array_weaponmods_ini[$i][2]) > 0 And $array_weaponmods_ini[$i][$j + 4] = 1 Then ; if type is weapon type and modstruct corresponds and the relevant weapon type is marked as a 1
						Out("Item has useful mod " & $array_weaponmods[$i][0] & " with index " & $array_weaponmods_ini[$i][1])
						SetExtended($array_weaponmods_ini[$i][1])
						Return True
					EndIf
				Next
			Next
	EndSwitch

	Return False

EndFunc   ;==>HasUsefulMod

Func SellRunes()
	RuneTrader()
	Sleep(GetPing() + 1000)
	For $bag = 1 To $UseBags
		$lBagPtr = GetBagPtr($bag)
		If $lBagPtr = 0 Then ContinueLoop
		For $slot = 1 To Memoryread($lBagPtr + 32, "long")
			$lItemPtr = GetItemPtrBySlot($bag, $slot)
			If $lItemPtr = 0 Then ContinueLoop
			$lItemType = MemoryRead($lItemPtr + 32, "byte")
			$lItemModelID = MemoryRead($lItemPtr + 44, "long")
			If $lItemType == $TYPE_RUNE_AND_MOD and CanSellRune($lItemModelID) Then
				If GetGoldCharacter() >= 50000 Then DepositGold(90000)
				TraderRequestSell($lItemPtr)
				PingSleep(250)
				TraderSell()
			EndIf
		Next
	Next
EndFunc

Func SellMaterials()
	RareMaterialTrader()
	For $bag = 1 To $UseBags
		$lBagPtr = GetBagPtr($bag)
		If $lBagPtr = 0 Then ContinueLoop
		For $slot = 1 To Memoryread($lBagPtr + 32, "long")
			$lItemPtr = GetItemPtrBySlot($bag, $slot)
			If $lItemPtr = 0 Then ContinueLoop
			If MemoryRead($lItemPtr + 32, "byte") <> 11 Then ContinueLoop
			$lItemModelID = MemoryRead($lItemPtr + 44, "long")
			$lMatRarity = MaterialRarity($lItemModelID)
			If $lMatRarity = 2 Then
				For $i = 1 To MemoryRead($lItemPtr + 75, "byte")
					TraderRequestSell($lItemPtr)
					Out("Sell rare materials: " & $bag & ", " & $slot)
					Sleep(PingSleep(250))
					TraderSell()
				Next
			ElseIf $lMatRarity = 1 Then
				For $i = 1 To Floor(MemoryRead($lItemPtr + 75, "byte") / 10)
					Out("Sell materials: " & $bag & ", " & $slot)
					TraderRequestSell($lItemPtr)
					Sleep(250)
					TraderSell()
				Next
			EndIf
		Next
	Next
EndFunc

Func MaterialRarity($aModelID)
	Switch $aModelID
		Case 930, 935 to 538, 945, 6532, 6533	; ectos, diamond, onyx, ruby, saphire, obsidian shards, amber, jadeite
			Return 1
		Case 929, 933, 934 	; Dust, Feather, Fiber
			Return 0
		Case 955, 948, 921	; Granite, Iron, Bone
			Return 0
		Case 925, 940, 946, 953, 954 ; cloth, tanned hide, wood scales, chitin
			Return 1
		Case 922, 923, 926 to 928, 931, 932, 939, 941 to 944, 949 to 952, 956 ; other rare materials
			Return 2
		Case 6532, 6533
			Return 0
	EndSwitch
EndFunc   ;==>checkmaterial

Func CountTotalSlots($NumOfBags = 4)
	Local $lCount = 0
	For $lBag = 1 To $NumOfBags
		$lBagPtr = GetBagPtr($lBag)
		If $lBagPtr = 0 Then ContinueLoop
		$lCount += MemoryRead($lBagPtr + 32, "long")
	Next
	Return $lCount

EndFunc   ;==>CountTotalSlots

Func CountFreeSlots($NumOfBags = 4)
	Local $lCount = 0
	For $lBag = 1 To $NumOfBags
		$lBagPtr = GetBagPtr($lBag)
		If $lBagPtr = 0 Then ContinueLoop
		$lCount += MemoryRead($lBagPtr + 32, "long") - MemoryRead($lBagPtr + 16, "long")
	Next
	Return $lCount
EndFunc   ;==>CountFreeSlots

;~ $aBag defines up to which bag it will look for salvage kits -> 16 = complete inventory and complete chest | 4 = inventory only
Func Sell($bagIndex, $numOfSlots)
	$numOfSlots = DllStructGetData($Bag, 'slots')
	Sleep(Random(150, 250))
	For $i = 0 To $numOfSlots - 1
		$aItem = GetItemBySlot($bagIndex, $i)
		If CanSell($aItem) Then
			SellItem($aItem)
			Sleep(Random(500, 550))
		EndIf
	Next
EndFunc   ;==>Sell

Func StoreTomes()
	"Storing Tomes"
	StoreTome(1, 20)
	StoreTome(2, 10)
	StoreTome(3, 15)
	StoreTome(4, 15)
EndFunc   ;==>StoreTomes

Func StoreTome($lBag, $numOfSlots)                                                    ;store the tomes of a given bag considering the total number of slots in that bag
	For $lSlot = 1 To CountTotalSlots()
		$lItemPtr = GetItemPtrBySlot($lBag, $lSlot)
		$lModelID = MemoryRead($lItemPtr + 44, "long")                       ; model ID of item in inventory bag $lBag and slot $lSlot
		If _ArrayBinarySearch($Tomes, $lModelID) = -1 Then ContinueLoop               ; continues loop if the Model ID of item does not correspond to a tome
		Out("The item in bag " & $lBag & ", Slot " & $lSlot & " is a tome")
		$StorageIndex = BestStorageSlotbyModelID($lModelID, 8, 12)                      ; looking in bags 8 to 12 (change based on available storage)
		If $StorageIndex[0] > 0 Then MoveItem($lItemPtr, $StorageIndex[0], $StorageIndex[1])
		Out("Moving tome to bag " & $StorageIndex[0] & ", slot " & $StorageIndex[1])
		PingSleep(200)
	Next
EndFunc   ;==>StoreTome

Func BestStorageSlotbyModelID($ItemModelID, $FirstBag, $LastBag) ; finds the best storage bag and slot to store an item of a given Model ID: existing stack > empty slot position > no slot (returns false)
	; $BAG_Backpack = 1, $BAG_BeltPouch, $BAG_Bag1, $BAG_Bag2, $BAG_EquipmentPack, $BAG_UnclaimedItems = 7, $BAG_Storage1, $BAG_Storage2, _
	; $BAG_Storage3, $BAG_Storage4, $BAG_Storage5, $BAG_Storage6, $BAG_Storage7, $BAG_Storage8, $BAG_StorageAnniversary
	Local $StorageIndex[2]

	For $bag = $LastBag To $FirstBag Step -1							; bags in reverse order so that found empty slot will be in an early bag
		$lBagPtr = GetBagPtr($bag)
		If $lBagPtr = 0 Then ContinueLoop
		For $slot = 1 To MemoryRead($lBagPtr + 32, "long")
			$lItemPtr = GetItemPtrBySlot($bag, $slot)
			If MemoryRead($lItemPtr + 44, "long") = $ItemModelID Then	; tome stack of exact Model ID found in current bag
				$StorageIndex[0] = $bag
				$StorageIndex[1] = $slot
				Return $StorageIndex									; --> stop cycling through bags, this is the best slot
			ElseIf MemoryRead($lItemPtr + 44, "long")  = 0 Then			; slot in current bag is empty, temp best slot
				$StorageIndex[0] = $bag
				$StorageIndex[1] = $slot
			EndIf
		Next
	Next
	Return $StorageIndex
EndFunc   ;==>BestStorageSlotbyModelID


Func FindEmptySlot($FirstBag, $LastBag) ;Parameter = bag index to start searching from. Returns integer with item slot. This function also searches the storage. If any of the returns = 0, then no empty slots were found
	; $BAG_Backpack = 1, $BAG_BeltPouch, $BAG_Bag1, $BAG_Bag2, $BAG_EquipmentPack, $BAG_UnclaimedItems = 7, $BAG_Storage1, $BAG_Storage2, _
	; $BAG_Storage3, $BAG_Storage4, $BAG_Storage5, $BAG_Storage6, $BAG_Storage7, $BAG_Storage8, $BAG_StorageAnniversary

	Local $StorageIndex[2]
	For $bag = $FirstBag To $LastBag
		$lBagPtr = GetBagPtr($bag)
		If $lBagPtr = 0 Then ContinueLoop		; bags in reverse order so that found empty slot will be in an early bag
		For $slot = 1 To Memoryread($lBagPtr + 32, "long")
			$lItemPtr = GetItemBySlot($bag, $slot)
			If $lItemPtr = 0 Then
				Out($bag & ", " & $slot & "  <-Empty! " & @CRLF)
				$StorageIndex[0] = $bag
				$StorageIndex[1] = $slot
				ExitLoop
			EndIf
		Next
	Next
	Return $StorageIndex
EndFunc   ;==>FindEmptySlot

Func StoreGoldItems()
	StoreGoldItem(1, 20)
	StoreGoldItem(2, 10)
	StoreGoldItem(3, 15)
	StoreGoldItem(4, 15)
EndFunc   ;==>StoreGoldItems

Func StoreGoldItem($lBag, $numOfSlots)
	For $lSlot = 1 To CountTotalSlots()
		ConsoleWrite("Checking items: " & $bagIndex & ", " & $i & @CRLF)
		$aItem = GetItemBySlot($lBag, $lSlot)
		If DllStructGetData($aItem, 'ID') <> 0 And GetRarity($aItem) = $RARITY_Gold Then
			$StorageIndex = FindEmptySlot(8, 12)                                ; looking in bags 8 to 12 (change based on available storage)
			If $StorageIndex[0] > 0 Then MoveItem($aItem, $StorageIndex[0], $StorageIndex[1])
			Out("Moving gold item to bag " & $StorageIndex[0] & ", slot " & $StorageIndex[1])
			Sleep(Random(450, 550))
		EndIf
	Next
EndFunc   ;==>StoreGoldItem

Func StoreRareSkins()
	Out("Storing Rare Skins...")
	StoreRare(1, 20)
	StoreRare(2, 10)
	StoreRare(3, 15)
	StoreRare(4, 15)
EndFunc   ;==>StoreRareSkins

Func StoreRare($bag, $numOfSlots)
	$lBagPtr = GetBagPtr($bag)
	For $slot = 1 To Memoryread($lBagPtr + 32, "long")
		;	  Out("Checking items: " & $bagIndex & ", " & $i & @CRLF)
		$lItemPtr = GetItemPtrBySlot($bag, $slot)
		$aModelID = MemoryRead($lItemPtr + 44, "long")
		If $lItemPtr <> 0 And GetRarity($lItemPtr) = $RARITY_Gold And GetItemReq($lItemPtr) < 12 And $aRareSkin[$aModelID] <> "" Then
			Out("Storing " & $aRareSkin[$aModelID])
			$StorageIndex = FindEmptySlot(8, 12)                                ; looking in bags 8 to 12 (change based on available storage)
			If $StorageIndex[0] > 0 Then MoveItem($lItemPtr, $StorageIndex[0], $StorageIndex[1])
		EndIf
	Next
EndFunc   ;==>StoreRare

Func CanSellRune($aItem)
	Local $aModelID = DllStructGetData($aItem, 'ModelID')

	Switch $aModelID
		Case 5551 ; sup vigor
			Return False
		Case Else
			Return True
	EndSwitch

EndFunc   ;==>CanSellRune

