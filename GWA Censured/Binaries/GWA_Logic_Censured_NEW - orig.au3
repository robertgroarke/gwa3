	DllStructSetData($mMakeAgentArray, 1, GetValue('CommandMakeAgentArray'))
	DllStructSetData($mChangeStatus, 1, GetValue('CommandChangeStatus'))

	; New functions, UI Messages
    DllStructSetData($mMoveItem, 1, GetValue('CommandUIMessage'))
    DllStructSetData($mMapTravel, 1, GetValue('CommandUIMessage'))
	DllStructSetData($mHeroSkillSlotState, 1, GetValue('CommandUIMessage'))

	; New functions, Straight to GW
    DllStructSetData($mVendorCollect, 1, GetValue('CommandVendorCollect'))
	DllStructSetData($mMoveGold, 1, GetValue('CommandMoveGold'))
	DllStructSetData($mDialog, 1, GetValue('CommandSendDialog'))
