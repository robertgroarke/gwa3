#Region Inventory

Func ClearInventory()
	Local $aItem, $aMod, $Timer
	Out("Cleaning Inventory")
	TravelGH()
	CheckGuildHall()
    PingSleep(500)
	If GUI_IsRareSkinsChecked() Then StoreRareSkins()
	StoreTomes()
	SalvageSellItems()
	SellRunes()
	SellMaterials()
	BuyScrolls()
EndFunc   ;==>ClearInventory

;RG
Func SalvageItems()
	Local $itemArray[0]
	If FindIDKit() < 1 Then Return
	If FindSalvageKit() < 1 Then Return
	IdentifyBags()
	For $bag = 1 To $UseBags
		$lBagPtr = GetBagPtr($bag)
		If $lBagPtr = 0 Then ContinueLoop
		For $slot = 1 To Memoryread($lBagPtr + 32, "long")
			$lItemPtr = GetItemPtrBySlot($bag, $slot)
			;If GetItemModelID($lItemPtr) <> 2415 Then ContinueLoop ;  Great Conch only
			If $lItemPtr = 0 Or Not CanSell($lItemPtr) Then ContinueLoop
			If HasUsefulMod($lItemPtr) Then
				ContinueLoop ; temporary until we figure out why we are getting dced
				$aMod = @extended
				;Seem to be getting dced here...
				Out("Salvaging mod...")
				StartSalvage($lItemPtr, False)        ; make sure it selects the right kit
				PingSleep(50)
				SalvageMod($aMod)
				Local $ldeadlock = TimerInit()
				Do
					Sleep(10)
				Until TimerDiff($ldeadlock) > (500 + GetPing()) Or DllStructGetData($lItemPtr, "ID") = 0 Or IAmDisconnected() = True
			Else
				Local $lRarity = GetRarity($lItemPtr)
				;Out("Enter Else")
				; Salvage Rare Weapons only
				If $lRarity = $Rarity_GOLD Then
					local $atype = MemoryRead(GetItemPtr($lItemPtr) + 32, "byte")
					Switch $atype
						Case 2, 5, 12, 15, 22, 24, 26, 27, 32, 35, 36
							Out("Salvage Weapon for Materials")
							StartSalvage($lItemPtr, True) ;True
							Sleep(GetPing())
							SalvageMaterials()
							Local $ldeadlock = TimerInit()
							Do
								Sleep(10)
							Until TimerDiff($ldeadlock) > (500 + GetPing()) Or DllStructGetData($lItemPtr, "ID") = 0 Or IAmDisconnected() = True
					EndSwitch
				EndIf
			EndIf
		Next
	Next
EndFunc

;RG
Func SalvageItems2()
	Local $itemArray[0]
	If FindIDKit() < 1 Then Return
	If FindSalvageKit() < 1 Then Return
	IdentifyBags()
	For $bag = 1 To $UseBags
		$lBagPtr = GetBagPtr($bag)
		If $lBagPtr = 0 Then ContinueLoop
		For $slot = 1 To Memoryread($lBagPtr + 32, "long")
