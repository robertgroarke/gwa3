Global $GUI_GroupDropStatistics_lblLockpicks 	= 0
Global $GUI_GroupDropStatistics_lblChests 		= 0
Global $GUI_GroupDropStatistics_lblDyes 		= 0
Global $GUI_GroupDropStatistics_lblTomes 		= 0
