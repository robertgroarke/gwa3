;~ Description: Returns item ID of ID kit in inventory.
Func FindIDKit()
	Local $LITEM
	Local $LKIT = 0
	Local $LUSES = 101
	For $i = 1 To 16
		For $J = 1 To DllStructGetData(GetBag($i), 'Slots')
			$LITEM = GetItemBySlot($i, $J)
			Switch DllStructGetData($LITEM, 'ModelID')
				Case 2989
					If DllStructGetData($LITEM, 'Value') / 2 < $LUSES Then
						$LKIT = DllStructGetData($LITEM, 'ID')
						$LUSES = DllStructGetData($LITEM, 'Value') / 2
					EndIf
				Case 5899
					If DllStructGetData($LITEM, 'Value') / 2.5 < $LUSES Then
						$LKIT = DllStructGetData($LITEM, 'ID')
						$LUSES = DllStructGetData($LITEM, 'Value') / 2.5
					EndIf
				Case Else
					ContinueLoop
			EndSwitch
		Next
	Next
	Return $LKIT
EndFunc   ;==>FindIDKit

Func GetUImessageID()
	Return MemoryRead($mUIMessageID) ;Return Hex(MemoryRead($mUIMessageID), 8)
EndFunc  

#cs
Func WaitForUIMessage($ID, $timeout = 2000, $log = false)

	MemoryWrite($mUIMessageID, 0)
	MemoryWrite($mUIMessageIDSearch, $ID)
	Local $lDeadlock = TimerInit()

	Do 
		Sleep(10)
	Until GetUImessageID() == $ID Or TimerDiff($lDeadlock) > $timeout

	If (TimerDiff($lDeadlock) > $timeout) Then	
		Out("ERROR: " & Hex($ID, 8))
	Endif

EndFunc
#ce

Func StartUIHook($ID)

	MemoryWrite($mUIMessageID, 0)
	MemoryWrite($mUIMessageIDSearch, $ID)

EndFunc

Func EndUIHook($ID, $timeout = 2000)

	Local $lDeadlock = TimerInit()

	Do 
		Sleep(10)
		;Out("Message ID" & GetUImessageID())
	Until GetUImessageID() == $ID Or TimerDiff($lDeadlock) > $timeout

	If (TimerDiff($lDeadlock) > $timeout) Then	
		Out("ERROR: " & Hex($ID, 8))
	Endif

EndFunc

Func DialogHook($aDialog, $aTimeout = 2000)
	StartUIHook($UIMSG_Dialog)
	Dialog($aDialog)
	EndUIHook($UIMSG_Dialog, $aTimeout)
EndFunc

Func NPCHook($aNPC, $aTimeout = 2000)
	StartUIHook($UIMSG_Dialog)
	GoNPC($aNPC)
	EndUIHook($UIMSG_Dialog, $aTimeout)
EndFunc

Func BossGlow($agentid, $class = 2)
;RG This broke
	Return
    DllStructSetData($mBossGlow, 2, $agentid)
    DllStructSetData($mBossGlow, 3, $class)
	Enqueue($mBossGlowPtr, 12)

EndFunc   ;==>UITravel

