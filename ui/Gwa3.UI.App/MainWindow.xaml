                            TextTrimming="CharacterEllipsis" />
                 <TextBlock Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Text="{Binding SelectedSession.LaneTag}"
                            Foreground="{StaticResource MutedTextBrush}"
                            FontSize="12" />
             </Grid>
         </Border>
    </Grid>
</Window>
