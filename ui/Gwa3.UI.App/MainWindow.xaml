<Window x:Class="Gwa3.UI.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Gwa3.UI.App.Converters"
        Title="GWA3 Control Panel"
        Width="1500"
        Height="1060"
        MinWidth="1420"
        MinHeight="980"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/gwa3-control-panel.ico"
        Background="#EEF2F5">
    <Window.Resources>
        <Color x:Key="ShellBackgroundColor">#EEF2F5</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="SurfaceAltColor">#F7FAFC</Color>
        <Color x:Key="RailColor">#20242A</Color>
        <Color x:Key="RailAltColor">#2C3138</Color>
        <Color x:Key="TextColor">#1A202C</Color>
        <Color x:Key="MutedTextColor">#64748B</Color>
        <Color x:Key="BorderColor">#CBD5E1</Color>
        <Color x:Key="AccentColor">#2C7A7B</Color>
        <Color x:Key="WarnColor">#B7791F</Color>
        <Color x:Key="DangerColor">#C53030</Color>
        <SolidColorBrush x:Key="ShellBackground" Color="{StaticResource ShellBackgroundColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
        <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
        <SolidColorBrush x:Key="RailAltBrush" Color="{StaticResource RailAltColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

        <converters:StatusBrushConverter x:Key="StatusBrushConverter" />
        <converters:LogLevelBrushConverter x:Key="LogLevelBrushConverter" />

        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Margin" Value="0,5,14,5" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>

        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>

        <Style x:Key="SectionBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" MinHeight="72" Background="{StaticResource SurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="18,8,12,6">
                <TextBlock Text="GWA3 Control Panel" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{Binding FleetHealthBanner}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,8,16,8">
                <StackPanel Width="180" Margin="0,0,10,8">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Profile" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,10,8">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Bot" />
                    <ComboBox ItemsSource="{Binding BotOptions}" SelectedItem="{Binding SelectedBot}" DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Width="210" Margin="0,0,10,8">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Character" />
                    <ComboBox ItemsSource="{Binding CharacterOptions}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name" />
                </StackPanel>
                <StackPanel Width="125" Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Mode" />
                    <ComboBox ItemsSource="{Binding LaunchModes}" SelectedItem="{Binding SelectedLaunchMode}" />
                </StackPanel>
                <Button Content="Save Profile" Command="{Binding SaveProfileCommand}" Margin="0,0,8,8" />
                <Button Content="Validate" Command="{Binding ValidateCommand}" Margin="0,0,8,8" />
                <Button Content="Dry Run" Command="{Binding DryRunCommand}" Margin="0,0,8,8" />
                <Button Content="Launch" Command="{Binding LaunchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                <Button Content="Stop" Command="{Binding StopCommand}" Style="{StaticResource DangerButton}" Margin="0,0,0,8" />
            </WrapPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="266" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource RailBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                        <TextBlock Text="Sessions" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Lane, DLL, pipe, and process state" Foreground="#A0AEC0" FontSize="12" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding SelectedSession}"
                             Background="{StaticResource RailBrush}"
                             BorderThickness="0"
                             Margin="8,0,8,10">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource RailAltBrush}"
                                        BorderBrush="#3A414A"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding CharacterName}" Foreground="White" FontWeight="SemiBold" />
                                        <Border Grid.Row="0" Grid.Column="1"
                                                Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" />
                                        </Border>

                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding BotModule}" Foreground="#CBD5E1" FontSize="12" Margin="0,5,0,0" />
                                        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding BotPhase}" Foreground="#FBBF24" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding DllName}" Foreground="#A0AEC0" FontSize="12" />
                                        <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding PipeName}" Foreground="#A0AEC0" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <TabControl Grid.Column="1" Margin="12" SelectedIndex="1">
                <TabItem Header="Configuration">
                    <TabControl Margin="0">
                <TabItem Header="Launch">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="0.95*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SectionBorder}" Margin="0,0,8,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource SectionTitle}" Text="Launch selection" />

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Bot module" />
                                    <ComboBox ItemsSource="{Binding BotOptions}" SelectedItem="{Binding SelectedBot}" DisplayMemberPath="Name" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Character" />
                                    <ComboBox ItemsSource="{Binding CharacterOptions}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Launch mode" />
                                    <ComboBox ItemsSource="{Binding LaunchModes}" SelectedItem="{Binding SelectedLaunchMode}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,10">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Resolved profile" />
                                    <TextBox Text="ui/runs/preview-trade-helper/resolved-profile.json" IsReadOnly="True" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal">
                                    <CheckBox Content="Hard mode" IsChecked="{Binding HardMode}" />
                                    <CheckBox Content="Use consets" IsChecked="{Binding UseConsets}" />
                                    <CheckBox Content="Open chests" IsChecked="{Binding OpenChests}" />
                                    <CheckBox Content="Pickup gold" IsChecked="{Binding PickupGold}" />
                                    <CheckBox Content="Auto salvage" IsChecked="{Binding AutoSalvage}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SectionBorder}" Margin="8,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}" Text="Selected lane" />
                                <UniformGrid Grid.Row="1" Columns="2">
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lane" />
                                        <TextBox Text="{Binding SelectedSession.LaneTag}" IsReadOnly="True" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="PID" />
                                        <TextBox Text="{Binding SelectedSession.Pid}" IsReadOnly="True" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="DLL" />
                                        <TextBox Text="{Binding SelectedSession.DllName}" IsReadOnly="True" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Health" />
                                        <TextBox Text="{Binding SelectedSession.Health}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="54" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Bot phase" />
                                        <TextBox Text="{Binding SelectedSession.BotPhase}" IsReadOnly="True" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,8">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Last event" />
                                        <TextBox Text="{Binding SelectedSession.LastEvent}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="54" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Grid.Row="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Pipe" />
                                    <TextBox Text="{Binding SelectedSession.PipeName}" IsReadOnly="True" />
                                </StackPanel>
                                <TextBlock Grid.Row="3" Text="Live wiring must call GWLauncher, wait for the exact returned PID to become healthy, then inject the lane DLL only into that PID." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SectionBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.9*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Validation" />
                                    <ListView ItemsSource="{Binding ValidationChecks}" MinHeight="240">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="State" Width="70" DisplayMemberBinding="{Binding State}" />
                                                <GridViewColumn Header="Check" Width="180" DisplayMemberBinding="{Binding Name}" />
                                                <GridViewColumn Header="Detail" Width="300" DisplayMemberBinding="{Binding Detail}" />
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Recent launch log" />
                                    <ListBox ItemsSource="{Binding LaunchLogEntries}" MinHeight="240">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,2">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Timestamp}" Foreground="{StaticResource MutedTextBrush}" Width="58" />
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Level}" Foreground="{Binding Level, Converter={StaticResource LogLevelBrushConverter}}" Width="58" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Message}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Profile">
                    <Grid Margin="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SectionBorder}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Profile identity" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Profile name" />
                                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Bot module" Margin="0,12,0,4" />
                                <ComboBox ItemsSource="{Binding BotOptions}" SelectedItem="{Binding SelectedBot}" DisplayMemberPath="Name" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Character" Margin="0,12,0,4" />
                                <ComboBox ItemsSource="{Binding CharacterOptions}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Hero config file" Margin="0,12,0,4" />
                                <TextBox Text="{Binding HeroConfigFile, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource SectionBorder}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Runtime toggles" />
                                <WrapPanel>
                                    <CheckBox Content="Hard mode" IsChecked="{Binding HardMode}" />
                                    <CheckBox Content="Use consets" IsChecked="{Binding UseConsets}" />
                                    <CheckBox Content="Use stones" IsChecked="{Binding UseStones}" />
                                    <CheckBox Content="Disable rendering" IsChecked="{Binding DisableRendering}" />
                                    <CheckBox Content="Open chests" IsChecked="{Binding OpenChests}" />
                                    <CheckBox Content="Pickup gold" IsChecked="{Binding PickupGold}" />
                                    <CheckBox Content="Auto identify" IsChecked="{Binding AutoIdentify}" />
                                    <CheckBox Content="Auto salvage" IsChecked="{Binding AutoSalvage}" />
                                    <CheckBox Content="Merchant restock" IsEnabled="False" />
                                    <CheckBox Content="Store protected items" IsEnabled="False" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Operator notes" Margin="0,14,0,4" />
                                <TextBox Height="160"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Text="Keep normal runs deterministic. Enable LLM mode only after the bridge pipe and action permissions are visible in Diagnostics." />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Team/Skills">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource SectionBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Player template" />
                                    <TextBox Text="{Binding PlayerTemplate, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Hero config file" />
                                    <TextBox Text="{Binding HeroConfigFile, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource SectionBorder}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="Skillbars and attributes" Margin="0,0,16,0" />
                                    <Button Content="Import Template" IsEnabled="False" />
                                    <Button Content="Apply to Heroes" IsEnabled="False" />
                                    <Button Content="Validate Builds" Command="{Binding ValidateCommand}" />
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding HeroBuilds}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Slot" Width="90" Binding="{Binding Slot}" />
                                        <DataGridTextColumn Header="Name" Width="150" Binding="{Binding Name}" />
                                        <DataGridTextColumn Header="Template" Width="*" Binding="{Binding Template}" />
                                        <DataGridTextColumn Header="Role" Width="120" Binding="{Binding Role}" />
                                        <DataGridTextColumn Header="Behavior" Width="130" Binding="{Binding Behavior}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Inventory">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource SectionBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <StackPanel Width="220" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Policy filter" />
                                        <TextBox Text="weapons, mods, materials" IsEnabled="False" />
                                    </StackPanel>
                                    <StackPanel Width="180">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Policy set" />
                                        <ComboBox SelectedIndex="0" IsEnabled="False">
                                            <ComboBoxItem Content="Default farm policy" />
                                            <ComboBoxItem Content="Conservative salvage" />
                                            <ComboBoxItem Content="Keep all mods" />
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="Import BotsHub JSON" IsEnabled="False" />
                                    <Button Content="Apply" Command="{Binding SaveProfileCommand}" Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="230" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource SectionBorder}" Margin="0,0,0,10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Pickup, identify, salvage, sell, and store rules" />
                                    <DataGrid ItemsSource="{Binding InventoryPolicies}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Category" Width="150" Binding="{Binding Category}" />
                                            <DataGridTextColumn Header="Rule" Width="220" Binding="{Binding Rule}" />
                                            <DataGridTextColumn Header="Decision" Width="180" Binding="{Binding Decision}" />
                                            <DataGridTextColumn Header="Notes" Width="*" Binding="{Binding Notes}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource SectionBorder}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="GWA2-style upgrade salvage matrix" />
                                    <DataGrid ItemsSource="{Binding UpgradeSalvageRules}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Width="46" Binding="{Binding Enabled}" />
                                            <DataGridTextColumn Header="Group" Width="135" Binding="{Binding Group}" />
                                            <DataGridTextColumn Header="Mod" Width="210" Binding="{Binding Name}" />
                                            <DataGridTextColumn Header="Slot" Width="95" Binding="{Binding SalvageSlot}" />
                                            <DataGridTextColumn Header="Min" Width="70" Binding="{Binding MinimumRarity}" />
                                            <DataGridTextColumn Header="Types" Width="145" Binding="{Binding ItemTypesSummary}" />
                                            <DataGridTextColumn Header="Pattern" Width="130" Binding="{Binding ModifierPattern}" />
                                            <DataGridCheckBoxColumn Header="Staff" Width="58" Binding="{Binding Staff}" />
                                            <DataGridCheckBoxColumn Header="Wand" Width="58" Binding="{Binding Wand}" />
                                            <DataGridCheckBoxColumn Header="Focus" Width="60" Binding="{Binding Focus}" />
                                            <DataGridCheckBoxColumn Header="Shield" Width="62" Binding="{Binding Shield}" />
                                            <DataGridCheckBoxColumn Header="Axe" Width="52" Binding="{Binding Axe}" />
