root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA2008.severity = warning
dotnet_diagnostic.CA2012.severity = error
dotnet_diagnostic.VSTHRD002.severity = error
dotnet_diagnostic.VSTHRD100.severity = error
dotnet_diagnostic.VSTHRD103.severity = warning
dotnet_diagnostic.VSTHRD110.severity = error
dotnet_diagnostic.MA0040.severity = warning
dotnet_diagnostic.MA0042.severity = error
dotnet_diagnostic.MA0045.severity = warning
dotnet_diagnostic.CA1063.severity = warning
dotnet_diagnostic.CA2000.severity = error
dotnet_diagnostic.CA2213.severity = warning
dotnet_diagnostic.IDISP001.severity = warning
dotnet_diagnostic.IDISP003.severity = warning
dotnet_diagnostic.IDISP004.severity = warning
dotnet_diagnostic.CA1031.severity = warning
dotnet_diagnostic.CA1851.severity = warning
dotnet_diagnostic.CA2241.severity = error
dotnet_diagnostic.CA2254.severity = warning
dotnet_diagnostic.CA3003.severity = error
dotnet_diagnostic.CA3061.severity = warning
dotnet_diagnostic.CA5350.severity = error
dotnet_diagnostic.CA5351.severity = error
dotnet_diagnostic.CA5394.severity = warning
dotnet_diagnostic.IDE0058.severity = none
dotnet_diagnostic.IDE0059.severity = none
dotnet_diagnostic.CA1303.severity = none
