  "launch": {
    "launchMode": "bot",
    "laneTag": "trade-helper",
    "buildDirectory": "build_trade",
    "dllName": "gwa3_trade.dll",
    "pipeName": "\\\\.\\pipe\\gwa3_llm_trade",
    "launcherScriptPath": "launch_sample_three_via_gwlauncher.au3",
    "injectorPath": "build_trade\\\\bin\\\\Release\\\\injector.exe",
    "freshClientRequired": true,
    "passProfilePathToInjector": false,
    "healthGate": {
      "timeoutSeconds": 30,
      "pollIntervalMilliseconds": 500,
      "requiredWorkingSetKilobytes": 100000,
      "postHealthySettleMilliseconds": 8000
    },
    "extraInjectorArguments": []
  },
  "llm": {
    "mode": "off",
    "endpoint": "http://localhost:11434/v1",
    "model": "deepseek-v4-pro:cloud",
    "hourlyTokenCap": 10000000,
    "allowRemote": false,
    "autonomyLevel": "advisory",
    "allowedActions": [
      "observe",
      "chat",
      "set_bot_goal",
      "pause_bot",
      "resume_bot"
    ],
    "chat": {
      "mode": "operatorSteered",
      "personaName": "GWA3 Operator Copilot",
      "systemPrompt": "Help the operator understand bot status, explain risk before actions, and keep Guild Wars automation inside the configured action permissions.",
      "steeringInstructions": "Default to advisory responses until the operator explicitly enables LLM or advisory launch mode.",
      "maxHistoryMessages": 50,
      "temperature": 0.2
    }
  },
  "botSpecific": {
    "froggyHM": {
      "routeProfile": "default",
      "useCurrentHardcodedDefaults": true
    }
  }
