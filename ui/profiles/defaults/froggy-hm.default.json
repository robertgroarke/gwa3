  "runtime": {
    "hardMode": true,
    "useConsets": false,
    "useStones": false,
    "disableRendering": false,
    "openChests": true,
    "pickupGold": true,
    "autoIdentify": true,
    "autoSalvage": true
  },
  "maintenance": {
    "minimumFreeSlots": 5,
    "kits": {
      "minimumIdentificationKits": 1,
      "minimumSalvageKits": 1,
      "targetIdentificationKits": 3,
      "targetSalvageKits": 8,
      "targetExpertSalvageKits": 1
    },
    "gold": {
      "keepOnCharacterGold": 5000,
      "depositWhenCharacterGoldAtLeast": 80000
    },
    "consets": {
      "enabled": true,
      "restockFromStorage": false,
      "craftWhenBelowSets": 0,
      "targetStoredSetsEach": 25,
      "materialSlotTrigger": 10,
      "materialPressureFreeSlots": 10,
      "batchSets": 10
    }
  },
  "inventoryPolicy": {
    "pickup": {
      "mode": "excludeRules",
      "categoryTags": [ "gold", "rare", "event", "dungeon" ],
      "rules": [
        {
          "enabled": true,
          "name": "Skip low-value white weapons",
          "itemType": "weapon",
          "rarity": "white",
          "minimumValueGold": 0,
          "notes": "Seed rule for the UI policy grid; tune after bot defaults are imported."
        }
      ]
    },
    "identify": {
      "mode": "all",
      "categoryTags": [ "blue", "purple", "gold" ],
      "rules": []
    },
    "salvageMaterials": {
      "mode": "includeRules",
      "categoryTags": [ "commonMaterials" ],
      "rules": [
        {
          "enabled": true,
          "name": "Salvage cloth and dust candidates",
          "material": "cloth,dust",
          "notes": "Placeholder until current hard-coded bot salvage rules are exported."
        }
      ]
    },
    "salvageUpgrades": {
      "mode": "includeRules",
      "categoryTags": [ "valuableMods" ],
      "rules": [
        {
          "enabled": true,
          "name": "Salvage desirable inscription/mod patterns",
          "modifierPattern": "aptitude|fortitude|enchanting|measure",
          "rarity": "gold"
        }
      ]
    },
    "sell": {
      "mode": "excludeRules",
      "categoryTags": [ "merchantTrash" ],
      "rules": [
        {
          "enabled": true,
          "name": "Do not sell keep components",
          "itemType": "material",
          "notes": "Keep components are controlled by the keepComponents rule set."
        }
      ]
    },
    "store": {
      "mode": "includeRules",
      "categoryTags": [ "materials", "consumables", "rareDrops" ],
      "rules": []
    },
    "keepComponents": {
      "mode": "includeRules",
      "categoryTags": [ "consetMaterials", "rareMaterials" ],
      "rules": [
        {
          "enabled": true,
          "name": "Conset components",
          "material": "feather,iron,scale,bone,dust,fiber",
          "notes": "Initial list for later conset crafting policy."
        }
      ]
    },
